<misterromdescription>
    <name>Nibbler (Rev 6)</name>
    <setname>nibbler6</setname>
    <parent>nibbler</parent>
    <rbf>SNK6502</rbf>
    <mameversion>0289</mameversion>
    <year>1982</year>
