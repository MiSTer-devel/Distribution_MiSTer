<misterromdescription>
    <name>Bad Lands</name>
    <setname>badlands</setname>
    <parent>badlands</parent>
    <rbf>Badlands</rbf>
    <mameversion>0289</mameversion>
    <mratimestamp>20260907000000</mratimestamp>
    <year>1989</year>
    <manufacturer>Atari Games</manufacturer>
    <category>Driving</category>
    <region>World</region>
    <!-- The three bootleg sets (badlandsb, badlandsb2, badlandsm) are a
         different PCB with a Z80 sound section; they are not supported
         and have no MRA here. -->
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <platform>Atari Bad Lands (A047193-01)</platform>
    <players>2</players>
    <!-- MAME ROT0 and an SOS-2 raster measured at 15.4611 kHz: a horizontal
         15 kHz monitor, no rotation in the core. -->
    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>

    <!-- Download stream map, as decoded by rtl/mem/badlands_rom_loader.sv:
           0x000000  0x040000  maincpu
           0x040000  0x010000  audiocpu
           0x050000  0x060000  tiles
           0x0B0000  0x030000  sprites
         total 0x0E0000 bytes (917504).
         Generated from MAME's badlands.cpp ROM_START(badlands). -->
    <rom index="0" zip="badlands.zip" md5="none">
        <!-- maincpu 0x000000 + 0x40000 : 68000 program (256 KB), MAME LOAD16_BYTE.
             Inside an interleave output="16", map="01" supplies the FIRST byte of
             each output word (big endian D15:8) and map="10" the second (D7:0).
             The Atari fault table on manual page 51 names the sockets directly:
             at error address 00000 the UPPER byte is 20F and the LOWER byte is
             27F; at 20000 the upper is 17F and the lower is 24F.  MAME agrees
             (1008.20f and 1009.17f load at EVEN offsets).  So 20F/17F take
             map="01" and 27F/24F take map="10".  This is the order fx68k needs.
             Proven on hardware by the Toobin' core: the opposite mapping
             byte swaps every opcode, so the 68000 reads a garbage reset vector and
             runs nonsense from its first instruction, with no error anywhere. -->
        <interleave output="16">
            <part name="136074-1008.20f" crc="a3da5774" map="01"/>
            <part name="136074-1006.27f" crc="aa03b4f3" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="136074-1009.17f" crc="0e2e807f" map="01"/>
            <part name="136074-1007.24f" crc="99a20c2c" map="10"/>
        </interleave>
        <!-- audiocpu 0x040000 + 0x10000 : 6502 sound program, the 27512 at 9C on the MAIN
             board (sheet 5).  0x4000 to 0xFFFF is the fixed window; 0x0000 to
             0x3FFF is seen through the 0x3000 window in four 4 KB pages selected
             by the BA13/BA12 bits of the 10E latch (0x2A04 D7:6). -->
        <part name="136074-1018.9c" crc="a05fd146"/>
        <!-- tiles 0x050000 + 0x60000 : playfield stamp ROMs, in the schematic's socket order
             4N 2N 4S 2S 4U 2U (sheet 3).  Two ROMs are read per fetch, giving 16
             bits = four 4 bpp pixels.  PFA17/PFA16 plus the 18S bank flop select
             the 4N/2N, 4S/2S or 4U/2U pair.
             POLARITY: MAME declares this region ROMREGION_INVERT and complements
             every byte after loading.  THIS MRA DOES NOT.  The board's shifter
             outputs are named /PF3:0, an ACTIVE LOW pen bus, which is exactly the
             polarity the raw ROM holds.  The core reads raw bytes. -->
        <part name="136074-1012.4n" crc="5d124c6c"/>
        <part name="136074-1013.2n" crc="b1ec90d6"/>
        <part name="136074-1014.4s" crc="248a6845"/>
        <part name="136074-1015.2s" crc="792296d8"/>
        <part name="136074-1016.4u" crc="878f7c66"/>
        <part name="136074-1017.2u" crc="ad0071a3"/>
        <!-- sprites 0x0B0000 + 0x30000 : motion object stamp ROMs 14R 10R 14T (sheet 4), in
             MAME's load order, which is the MOA17/MOA16 order: 14R at 0x00000,
             10R at 0x10000, 14T at 0x20000.  Socket 10T is NOT populated and is
             not part of the region, so the 0x30000 to 0x3FFFF quarter simply does
             not exist in this stream.
             POLARITY: ROMREGION_INVERT again, and again NOT applied here; the
             board's pen bus is /MO3:0, active low, matching the raw ROM. -->
        <part name="136074-1010.14r" crc="c15f629e"/>
        <part name="136074-1011.10r" crc="fb0b6717"/>
        <part name="136074-1019.14t" crc="0e26bff6"/>
    </rom>

    <!-- The six GAL16V8A fuse dumps in the MAME set (136074-1001 26C, -1002 21R,
         -1003 16S, -1004 9N, -1005 12E, -2000 26R, 0x117 bytes each) are NOT
         downloaded.  Their equations are compiled into the RTL at build time
         (decoded with jedutil); there is no runtime GAL. -->

    <!-- NVRAM: the 2816A EEPROM at 27J on index 2
         (0x800 = 2048 bytes, 0xFD0001 odd bytes, unlocked by a
         write to 0xFEE001).  This element opens MiSTer Main's index-2 save
         channel and adds the OSD "Save Settings" entry; the core answers it
         with badlands_nvram_io inside badlands_main.  It does not touch the
         index-0 ROM stream
         above: the EEPROM is not part of the download image, and the part
         ships erased (the game writes its own defaults from the self test). -->
    <nvram index="2" size="2048"/>
</misterromdescription>
