<misterromdescription>
	<name>Dog Fight</name>
	<region>World</region>
	<homebrew>no</homebrew>
	<bootleg>no</bootleg>
	<version></version>
	<alternative></alternative>
	<platform></platform>
	<series>Dog Fight</series>
	<year>1983</year>
	<manufacturer>Orca / Thunderbolt</manufacturer>
	<category>Shooter</category>

	<setname>dogfight</setname>
	<parent>dogfight</parent>
	<mameversion>0289</mameversion>
	<rbf>Vastar</rbf>
	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (ccw)</rotation>
	<flip>no</flip>

	<players>2 (alternating)</players>
	<joystick>2-way horizontal</joystick>
	<special_controls></special_controls>
	<num_buttons>2</num_buttons>
	<button_names>Fire,Not Used</button_names>

	<switches default="00,40">
		<!-- DSW0 (6081) -->
		<dip bits="0,2"   name="Coin B" ids="1C/1C,1C/2C,1C/3C,1C/4C,1C/6C,2C/1C,3C/2C,Free Play"/>
		<dip bits="3,5"   name="Coin A" ids="1C/1C,1C/2C,1C/3C,3C/4C,2C/1C,3C/1C,4C/1C,5C/1C"/>
		<dip bits="6"     name="Unknown" ids="Off,On"/>
		<dip bits="7"     name="Unknown" ids="Off,On"/>
		<!-- DSW1 (6082) -->
		<dip bits="8,9"   name="Lives" ids="3,4,5,6"/>
		<dip bits="10"    name="Unused" ids="Off,On"/>
		<dip bits="11"    name="Unused" ids="Off,On"/>
		<dip bits="12"    name="Invulnerability" ids="Off,On"/>
		<dip bits="13"    name="Bonus Life" ids="20000 50000,40000 70000"/>
		<dip bits="14"    name="Cabinet" ids="Cocktail,Upright"/>
		<dip bits="15"    name="Freeze" ids="Off,On"/>
	</switches>

	<!-- Index 0: Zodiack board main ROM (C000-CFFF stored at 5000), audio ROM, empty Vastar video regions, then the Orca
	     OVG-40c video board -->
	<rom index="0" md5="none" zip="dogfight.zip">
		<part crc="ad24b28b" name="df-2.4f"/>
		<part crc="cd172707" name="df-3.4h"/>
		<part crc="874dc6bf" name="df-5.4n"/>
		<part crc="d8aa3d6d" name="df-4.4m"/>
		<part repeat="0x2000"> 00 </part>
		<part crc="dcbb1c5b" name="df-1.4n"/>
		<part repeat="0x1000"> 00 </part>
		<part repeat="0xA400"> 00 </part>
		<part crc="3059b515" name="df-6.3s"/>
		<part crc="ffe05fee" name="df-7.7n"/>
		<part crc="2cb51793" name="df-8.7r"/>
		<part repeat="0x800"> 00 </part>
		<part crc="69a35aa5" name="mmi6331.2a"/>
		<part crc="596ae457" name="mmi6331.2b"/>
	</rom>

	<!-- Index 1: core_config (bit1 OVG-40c video, bit2 Zodiack CPU board), then the IN0 / IN1 input map, one control id
	     per bit (rtl top level: 1-4 P1 U/D/L/R, 5 P1 button 1, 9-12 P2 U/D/L/R, 13 P2 button 1, 17 / 18 coin 1 / 2,
	     19 / 20 start 1 / 2, 0 none) -->
	<rom index="1">
		<part>
		06
		13 14 0C 0B 00 00 00 00
		12 11 00 04 00 0D 05 03
		</part>
	</rom>

	<remark>Dog Fight (Orca / Thunderbolt)</remark>
	<mratimestamp>20261010000000</mratimestamp>
</misterromdescription>
