<misterromdescription>
	<name>Legion (Bootleg Of Legend)</name>
	<region>World</region>
	<year>1986</year>
	<manufacturer>bootleg</manufacturer>
	<category>Shooter</category>

	<setname>legendb</setname>
	<parent>legend</parent>
	<rbf>Kyugo</rbf>
	<mameversion>0289</mameversion>

	<resolution>15kHz</resolution>
	<rotation>horizontal</rotation>
	<flip>no</flip>

	<players>2 (alternating)</players>
	<joystick>8-way</joystick>
	<num_buttons>2</num_buttons>
	<button_names>Fire,Bomb</button_names>

	<switches default="BF,FF">
		<!-- DSW1 (AY1 port A, read & inverted by sub) -->
		<dip bits="0,1"      name="Lives"          ids="6,5,4,3"/>
		<dip bits="2"        name="Bonus/Continue" ids="70k/Yes,50k/No"/>
		<dip bits="3"        name="Slow Motion"    ids="On,Off"/>
		<dip bits="4"        name="DSW1.5 (unused)" ids="On,Off"/>
		<dip bits="5"        name="Sound Test"     ids="On,Off"/>
		<dip bits="6"        name="Cabinet"        ids="Upright,Cocktail"/>
		<dip bits="7"        name="Freeze"         ids="On,Off"/>
		<!-- DSW2 (AY1 port B) -->
		<dip bits="8,10"     name="Coin A"         ids="Free Play,3C/2C,2C/1C,1C/6C,1C/4C,1C/3C,1C/2C,1C/1C"/>
		<dip bits="11,13"    name="Coin B"         ids="5C/1C,4C/1C,3C/1C,2C/1C,3C/4C,1C/3C,1C/2C,1C/1C"/>
	</switches>

	<!-- Index 1: variant | rot_flip (bit 3) | landscape (bit 4). MAME machine config "legend" = the parent's. -->
	<rom index="1">
		<part>14</part>
	</rom>

	<!-- Index 0: main 32K, sub 32K, FG 4K, BG planes 3x 16K (8K + pad, in MAME's "plane N" order), sprite planes
	     3x 32K, PROMs R / G / B, char lookup, timing (rtl/ram_rom/rom_loader.sv) -->
	<rom index="0" md5="none" zip="legendb.zip|legend.zip">
		<part crc="227f3e88" name="06.s02"/>
		<part crc="9352e9dc" name="07.s03"/>
		<part crc="41cee2b2" name="08.s04"/>
		<part crc="d8fd4e37" name="05.n03"/>
		<part crc="abfe5eb4" name="02.s07"/>
		<part crc="7e7b9ba9" name="03.s08"/>
		<part crc="0dd50aa7" name="04.s09"/>
		<part crc="13915a53" name="01.n07"/>
		<part crc="6c879f76" name="15.b05"/>
		<part crc="3bdcd028" name="18.j09"/>
		<part repeat="0x2000"> 00 </part>
		<part crc="105c5b53" name="17.j10"/>
		<part repeat="0x2000"> 00 </part>
		<part crc="b9ca4efd" name="16.j11"/>
		<part repeat="0x2000"> 00 </part>
		<part crc="1689f21c" name="14.b06"/>
		<part crc="f527c909" name="13.b07"/>
		<part crc="8d618629" name="12.b08"/>
		<part crc="7d7e2d55" name="11.b09"/>
		<part crc="f12232fe" name="10.b10"/>
		<part crc="8c09243d" name="09.b11"/>
		<part crc="40590ac0" name="82s129.1j"/>
		<part crc="e542b363" name="82s129.1h"/>
		<part crc="75536fc8" name="82s129.1f"/>
		<part crc="c98f0651" name="82s123.5j"/>
		<part crc="83a39201" name="m1.2c"/>
	</rom>

	<nvram index="4" size="2048"></nvram>
	<remark>Legion (Legend bootleg)</remark>
</misterromdescription>
