<misterromdescription>
  <name>Kid no Hore Hore Daisakusen (bootleg set 2)</name>
  <mameversion>0288</mameversion>
  <setname>horekidb2</setname>
  <year>1987</year>
  <manufacturer>bootleg</manufacturer>
  <category>Maze</category>
  <rotation>vertical (ccw)</rotation>
  <parent>horekid</parent>
  <rbf>TerraCrestaMD</rbf>

  <switches default="cf,ff,ff,ff">
    <!-- IN0 -->
    <dip name="Lives" bits="0,1" ids="3,4,5,6" values="3,2,1,0"/>
    <dip name="Bonus Life" bits="2,3" ids="20k/every 60k,50k/every 60k,20k/every 90k,50k/every 90k" values="3,2,1,0"/>
    <dip name="Demo Sounds" bits="4" ids="Off,On" values="1,0"/>
    <dip name="Cabinet" bits="5" ids="Upright,Cocktail" values="0,1"/>
    <dip name="Difficulty" bits="6,7" ids="Easy,Normal,Hard,Hardest" values="3,2,1,0"/>
    <dip name="Coin A" bits="8,9" ids="2 Coins/1 Credit,1 Coin/1 Credit,1 Coin/2 Credits,Free Play" values="1,3,2,0"/>
    <dip name="Coin B" bits="10,11" ids="2 Coins/1 Credit,1 Coin/1 Credit,2 Coins/3 Credits,1 Coin/2 Credits" values="1,3,0,2"/>
    <dip name="Unused" bits="12" ids="Off,On" values="1,0"/>
    <dip name="Flip Screen" bits="13" ids="Off,On" values="1,0"/>
    <dip name="Debug Mode" bits="14,15" ids="Off,On,Off,Off" values="3,2,1,0"/>
  </switches>

  <buttons names="Dig/Bury,Open/Close Door,Start,Coin,Pause,Save/Load" default="A,B,Start,Select,R,L"/>

  <rom index="0" zip="horekidb2.zip|horekid.zip" md5="a2d5fb5804253731e6ed715fb8386160">
    <!-- maincpu - starts at 0x0 -->
    <interleave output="16">
      <part name="1.bin" crc="af9cdd7e" map="01"/>
      <part name="5.bin" crc="2df0e086" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="2.bin" crc="ee7d52bb" map="01"/>
      <part name="6.bin" crc="375c0c50" map="10"/>
    </interleave>

    <!-- bgtiles - starts at 0x20000 -->
    <part name="9.bin" crc="da25ae10"/>
    <part name="10.bin" crc="616e4321"/>
    <part name="11.bin" crc="8c7d2be2"/>
    <part name="12.bin" crc="a0066b02"/>

    <!-- sprites - starts at 0x40000 -->
    <part name="14b.bin" crc="a3caa07a"/>
    <part name="15b.bin" crc="0e48ff8e"/>
    <part name="16b.bin" crc="e300747a"/>
    <part name="17b.bin" crc="51105741"/>

    <!-- fgtiles - starts at 0x60000 -->
    <part name="horekid.16" crc="104b77cc"/>
    <part repeat="0xe000">FF</part>

    <!-- audiocpu - starts at 0x70000 -->
    <part name="11b.bin" crc="3b85e6ef" offset="0x4000" length="0x4000"/>
    <part name="12b.bin" crc="b3a27456" offset="0x4000" length="0x4000"/>
    <part name="13b.bin" crc="78631a6c" offset="0x4000" length="0x4000"/>

    <!-- prot_chip - starts at 0x7c000 -->
    <part repeat="0x2000">FF</part>

    <!-- proms - starts at 0x7e000 -->
    <part name="kid_prom.10f" crc="ca13ce23"/>
    <part name="kid_prom.11f" crc="fb44285a"/>
    <part name="kid_prom.12f" crc="40d41237"/>
    <part name="kid_prom.2g" crc="4b9be0ed"/>

    <!-- palbank_prom - starts at 0x7e400 -->
    <part name="kid_prom.4e" crc="e4fb54ee"/>

    <!-- Total 0x7e500 bytes -->
  </rom>

  <!-- game select (pcb) -->
  <rom index="1">
    <part>04</part>
  </rom>

  <!-- hiscore table: address[4], length[2], start byte, end byte - MAME 0.288 plugins/hiscore/hiscore.dat -->
  <rom index="3" md5="none">
    <part>
      00 04 02 5A 00 28 00 01
    </part>
  </rom>
  <nvram index="4" size="40"/>
</misterromdescription>
