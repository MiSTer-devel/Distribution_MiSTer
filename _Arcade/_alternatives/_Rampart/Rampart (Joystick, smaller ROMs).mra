<misterromdescription>
    <name>Rampart (Joystick, smaller ROMs)</name>
    <setname>rampart2pa</setname>
    <parent>rampart</parent>
    <rbf>Rampart</rbf>
    <mameversion>0289</mameversion>
    <mratimestamp>20260922000000</mratimestamp>
    <year>1990</year>
    <manufacturer>Atari Games</manufacturer>
    <category>Strategy</category>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <platform>Atari Rampart (136082)</platform>
    <players>3</players>
    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>

    <about>
        Rampart for MiSTer - Atari Games 1990, board 136082 with the
        136082-1005 address decoder GAL at 12C and three joysticks.
        All ROMs load on ioctl index 0 as one 0x460802-byte stream that
        the core writes to SDRAM unchanged. Program ROMs are grouped by the
        socket pair the 12C GAL selects; the last two bytes name the GAL
        variant and the control panel. The factory EEPROM image is used only
        before a save file exists. The EEPROM is saved on index 2.
    </about>

    <rom index="0" zip="rampart2pa.zip|rampart.zip" md5="0becd53aa150c19ef4b7b4752aa2d8e6">
        <!-- 0x000000  10C Y0: socket pair 0h.13k-l (even, D15:8) + 0l.13h (odd, D7:0), 256 KB, MAME maincpu 0x00000 -->
        <interleave output="16">
            <part name="0h.13k-l" crc="d4e26d0f" map="01"/>
            <part name="0l.13h" crc="ed2a49bd" map="10"/>
        </interleave>
        <part repeat="0xC0000">FF</part>
        <!-- 0x100000  10C Y1: socket pair 1h.13l (even, D15:8) + 1l.13h-j (odd, D7:0), 256 KB, MAME maincpu 0x40000 -->
        <interleave output="16">
            <part name="1h.13l" crc="b232b807" map="01"/>
            <part name="1l.13h-j" crc="a2db78b1" map="10"/>
        </interleave>
        <part repeat="0xC0000">FF</part>
        <!-- 0x200000  10C Y2: socket pair 2h.13m (even, D15:8) + 2l.13j (odd, D7:0), 256 KB, MAME maincpu 0x80000 -->
        <interleave output="16">
            <part name="2h.13m" crc="37b32b7e" map="01"/>
            <part name="2l.13j" crc="00cd567b" map="10"/>
        </interleave>
        <part repeat="0xC0000">FF</part>
        <!-- 0x300000  10C Y3: socket pair 3h.13n (even, D15:8) + 3l.13k (odd, D7:0), 256 KB, MAME maincpu 0xC0000 -->
        <interleave output="16">
            <part name="3h.13n" crc="c23b1c98" map="01"/>
            <part name="3l.13k" crc="0a12ca83" map="10"/>
        </interleave>
        <part repeat="0xC0000">FF</part>
        <!-- 0x400000  motion-object graphics ROM, raw bytes (not inverted) -->
        <part name="atr.2n" crc="efa38bef"/>
        <!-- 0x420000  MSM6295 ADPCM ROMs -->
        <part name="arom0_2_player_136082-1007.2d" crc="c96a0fc3"/>
        <part name="arom1_2_player_136082-1006.1d" crc="518218d9"/>
        <!-- 0x460000  factory EEPROM image, used on a first boot only -->
        <part name="rampart-eeprom.bin" crc="0be57615"/>
        <!-- 0x460800  config: 12C GAL 136082-1005, joystick panel -->
        <part>05 01</part>
    </rom>

    <!-- 2816 EEPROM (settings and high scores) -->
    <nvram index="2" size="2048"/>

    <buttons names="Fire,Rotate,Coin" default="A,B,Select"/>
</misterromdescription>
