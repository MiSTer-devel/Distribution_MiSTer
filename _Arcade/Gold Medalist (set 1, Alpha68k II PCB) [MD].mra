<misterromdescription>
    <name>Gold Medalist (set 1, Alpha68k II PCB)</name>
    <setname>goldmedl</setname>
    <rbf>Alpha68kMD</rbf>
    <mameversion>0288</mameversion>
    <year>1988</year>
    <manufacturer>SNK</manufacturer>
    <region>World</region>
    <rotation>horizontal</rotation>

    <switches default="97,de">
        <!-- IN3 -->
        <dip name="Event Select" bits="2" ids="Off,On" values="1,0"/>
        <dip name="100M Dash Speed" bits="5" ids="10 Beats,14 Beats" values="0,1"/>
        <dip name="Computer Demonstration" bits="6" ids="Off,On" values="0,1"/>
        <dip name="Cabinet" bits="3" ids="Upright,Cocktail" values="0,1"/>
        <dip name="Upright Players" bits="7" ids="2,4" values="0,1"/>
        <!-- IN4 -->
        <dip name="Difficulty" bits="8,9" ids="Easy,Normal,Hard,Very Hard" values="3,2,1,0"/>
        <dip name="Coinage" bits="10,12" ids="A 1C/1C B 1C/1C,A 1C/2C B 2C/1C,A 1C/3C B 3C/1C,A 1C/4C B 4C/1C,A 1C/5C B 5C/1C,A 1C/6C B 6C/1C,A 2C/3C B 7C/1C,A 3C/2C B 8C/1C" values="7,6,5,4,3,2,1,0"/>
        <dip name="Demo Sounds" bits="13" ids="Off,On" values="1,0"/>
    </switches>

    <buttons names="Run/Spin/Power,Run/Spin/Hit Power,Jump/Jab/Throw Angle,-,-,Start,Coin,Pause,Save States" default="A,B,X,Start,Select,R,L"/>

    <rom index="1">
        <part>08 0E</part>
    </rom>

    <rom index="0" zip="goldmedl.zip" md5="None">

        <!-- maincpu - starts at 0x0 -->
        <interleave output="16">
            <part name="gm.3" crc="ddf0113c" map="01"/>
            <part name="gm.4" crc="16db4326" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="gm.1" crc="54a11e28" map="01"/>
            <part name="gm.2" crc="4b6a13e4" map="10"/>
        </interleave>
        <part repeat="0x40000"> FF</part>

        <!-- audiocpu - starts at 0x80000 -->
        <part name="38.bin" crc="4bf251b8"/>
        <part name="39.bin" crc="1d92be86"/>
        <part name="40.bin" crc="8dafc4e8"/>
        <part name="1.bin" crc="1e78062c"/>
        <part repeat="0x40000"> FF</part>

        <!-- gfx1 - starts at 0x100000 -->
        <interleave output="16">
            <part name="gm.5" crc="667f33f1" map="01"/>
            <part name="gm.6" crc="56020b13" map="10"/>
        </interleave>
        <part repeat="0xF0000"> FF</part>

        <!-- gfx2 - starts at 0x200000 -->
        <interleave output="32">
            <part name="goldchr3.c46" crc="6faaa07a" map="0001"/>
            <part name="goldchr2.c45" crc="e6b0aa2c" map="0010"/>
            <part name="goldchr1.c44" crc="55db41cd" map="0100"/>
            <part name="goldchr0.c43" crc="76572c3f" map="1000"/>
        </interleave>

        <!-- mcu - starts at 0x400000 -->
        <!-- <part name="alpha.mcu" crc=""/> -->

        <!-- Total 0x401000 bytes - 4100 kBytes -->
    </rom>

    <!-- hiscore: address[4] length[2] start end, MAME 0.288 plugins/hiscore/hiscore.dat -->
    <rom index="3" md5="none">
        <part>
            00 04 0A 20 00 A0 00 00
            00 04 0B 22 00 46 1B 00
            00 04 0B 20 00 02 00 01
        </part>
    </rom>
    <nvram index="4" size="232"/>
</misterromdescription>
