<misterromdescription>
    <name>Paddle Mania</name>
    <setname>paddlema</setname>
    <rbf>NextSpaceMD</rbf>
    <mameversion>0288</mameversion>
    <year>1988</year>
    <manufacturer>SNK</manufacturer>
    <players>4</players>
    <joystick>8-way</joystick>
    <rotation>vertical (cw)</rotation>
    <region>World</region>

    <switches default="73,0e">
        <!-- IN3 -->
        <dip name="Coin B" bits="0,1" ids="1 Coin/2 Credits,1 Coin/3 Credits,1 Coin/4 Credits,1 Coin/6 Credits" values="3,1,2,0"/>
        <dip name="Coin A" bits="2,3" ids="4 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit" values="3,1,2,0"/>
        <dip name="Game Time" bits="4,5" ids="Default Time,+10 Seconds,+20 Seconds,+30 Seconds" values="0,2,1,3"/>
        <dip name="Match Type" bits="6,7" ids="A to B,A to C,A to E" values="2,0,1"/>
        <!-- IN4 -->
        <dip name="Service Mode" bits="8" ids="Off,On" values="0,1"/>
        <dip name="Unused" bits="9" ids="Off,On" values="1,0"/>
        <dip name="Unused" bits="10" ids="Off,On" values="1,0"/>
        <dip name="Unused" bits="11" ids="Off,On" values="1,0"/>
        <dip name="Game Mode" bits="12,13" ids="Demo Sounds Off,Demo Sounds On,Win Match (Cheat),Freeze" values="2,0,1,3"/>
        <dip name="Language" bits="14" ids="English,Japanese" values="0,1"/>
        <dip name="Allow Continue" bits="15" ids="No,Yes" values="1,0"/>
    </switches>

    <buttons names="Left Swing,Right Swing,Start,Coin,Pause,Save States" default="A,B,Start,Select,R,L"/>

    <rom index="1">
        <part>01</part>
    </rom>

    <rom index="0" zip="paddlema.zip" md5="None">
        <!-- maincpu - starts at 0x0 -->
        <interleave output="16">
            <part name="padlem.6g" crc="c227a6e8" map="01"/>
            <part name="padlem.3g" crc="f11a21aa" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="padlem.6h" crc="8897555f" map="01"/>
            <part name="padlem.3h" crc="f0fe9b9d" map="10"/>
        </interleave>
        <part repeat="0x40000"> FF</part>

        <!-- gfx1 - starts at 0x80000 -->
        <interleave output="16">
            <part name="padlem.9m" crc="4ee4970d" map="01"/>
            <part name="padlem.16m" crc="0984fb4d" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="padlem.9n" crc="a1756f15" map="01"/>
            <part name="padlem.16n" crc="4249e047" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="padlem.6m" crc="3f47910c" map="01"/>
            <part name="padlem.13m" crc="fd9dbc27" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="padlem.6n" crc="fe337655" map="01"/>
            <part name="padlem.13n" crc="1d460486" map="10"/>
        </interleave>

        <!-- audiocpu - starts at 0x100000 -->
        <part name="padlem.18c" crc="9269778d"/>

        <!-- color_proms - starts at 0x110000 -->
        <part name="padlem.18n" crc="488df971"/>

        <!-- clut_proms - starts at 0x118000 -->
        <interleave output="16">
            <part name="padlem.17j" crc="86170069" map="01"/>
            <part name="padlem.16j" crc="8da58e2c" map="10"/>
        </interleave>

        <!-- proms - starts at 0x118800 -->
        <interleave output="32">
            <part name="padlem.a" crc="cae6bcd6" map="0001"/>
            <part name="padlem.b" crc="b6df8dcb" map="0010"/>
            <part name="padlem.c" crc="39ca9b86" map="0100"/>
        </interleave>

        <!-- Total 0x118C00 bytes - 1123 kBytes -->
    </rom>

    <!-- hiscore: address[4] length[2] start end, MAME 0.288 plugins/hiscore/hiscore.dat -->
    <rom index="3" md5="none">
        <part>
            00 08 01 A8 00 28 02 03
            00 08 21 08 00 A0 00 20
        </part>
    </rom>
    <nvram index="4" size="200"/>
</misterromdescription>
