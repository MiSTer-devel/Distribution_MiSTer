<misterromdescription>
	<about author="Paul Priest" webpage="https://github.com/ppriest/Arcade-Fuuki_MiSTer" source="MAME fuukifg2.cpp"/>
	<name>Susume! Mile Smile / Go Go! Mile Smile (newer)</name>
	<setname>gogomile</setname>
	<mameversion>0289</mameversion>
	<rbf>Fuuki</rbf>
	<year>1995</year>
	<manufacturer>Fuuki</manufacturer>
	<category>Maze</category>
	<rotation>horizontal</rotation>
	<region>Japan</region>
	<players>2</players>
	<joystick>8-way</joystick>

	<!-- Board select: bit 0 = FG-2 / FG-3, bit 1 = SYSTEM port wiring (gogomile / pbancho+asura). -->
	<rom index="1"><part>00</part></rom>

	<rom index="0" zip="gogomile.zip" md5="none" address="0x30000000">
		<interleave output="16">
			<part name="fp2n.rom2" crc="e73583a0" map="01"/>
			<part name="fp1n.rom1" crc="7b110824" map="10"/>
		</interleave>

		<part repeat="0x100000">FF</part>
		<part name="fs1.rom24" crc="4e4bd371"/>

		<part repeat="0x60000">FF</part>
		<interleave output="16">
			<part name="lh5370h6.rom3" crc="e2ca7107" map="12"/>
		</interleave>

		<interleave output="32">
			<part name="lh5370h7.rom15" crc="34921680" map="0012"/>
			<part name="lh5370h8.rom11" crc="9961c925" map="1200"/>
		</interleave>
		<interleave output="32">
			<part name="lh5370h9.rom16" crc="e0118483" map="0012"/>
			<part name="lh5370ha.rom12" crc="5f2a87de" map="1200"/>
		</interleave>

		<interleave output="16">
			<part name="lh5370hb.rom19" crc="bd1e896f" map="12"/>
		</interleave>

		<interleave output="16">
			<part name="lh537k2r.rom20" crc="525dbf51" map="12"/>
		</interleave>

		<part name="lh538n1d.rom25" crc="01622a95"/>
	</rom>

	<buttons names="Escape,-,-,-,Start,Coin,Pause" default="Y,Start,Select,R" count="1"/>

	<switches default="FF,FF">
		<dip name="Service Mode" bits="0" ids="On,Off"/>
		<dip name="Demo Music" bits="1" ids="Off,On"/>
		<dip name="Difficulty" bits="2,3" ids="Easy,Very Hard,Hard,Normal"/>
		<dip name="Language" bits="4,5" ids="Korean,Chinese,English,Japanese"/>
		<dip name="Lives" bits="6,7" ids="2,5,4,3"/>
		<!-- <dip name="Flip Screen" bits="8" ids="On,Off"/> -->
		<dip name="Coinage" bits="10,11,12" ids="Free Play,4C 1C,1C 3C,2C 1C,1C 4C,3C 1C,1C 2C,1C 1C"/>
	</switches>
</misterromdescription>
