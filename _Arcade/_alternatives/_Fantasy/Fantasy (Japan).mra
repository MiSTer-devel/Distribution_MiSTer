        <part crc="fa6903e2" name="fs9jic17.bin"/>
        <part repeat="0x3000">00</part>
        <part crc="bf59a33a" name="fs6jic14.bin"/>
        <part crc="86a801c3" name="fs10ic50.bin"/>
        <part crc="9dfff71c" name="fs11ic51.bin"/>
        <part crc="1aa9285a" name="prom-8.bpr"/>
        <part crc="7a6f7dc3" name="prom-7.bpr"/>
        <part crc="48094ec5" name="fs_b_51.bin"/>
