<?xml version="1.0" encoding="UTF-8"?>
<!--
  Treasure Island (Europe?) (ctisland3) — Type 1 Dongle (handcrafted), decocrom overlay-PCB ROM

  Per MAME decocass.cpp: GAME(1981, ctisland3, decocass, ctisland3, ctisland, decocass_type1_state,
  init_decocrom, ROT270, "Data East Corporation", "Treasure Island (DECO Cassette) (Europe?)", 0)
  (line 2153). Uses BIOS D (Europe) — DECOCASS_BIOS_D_ROMS, v0d-.7e (needed for THIS set specifically,
  per decocass.cpp:1303 comment "handcrafted (single byte changed) because ctisland3 requires region D").

  Dongle: Type 1, but with its OWN handcrafted 32 B PROM (ctisland3.pro, NOT the shared de-0061.pro) and
  IDENTITY in/out maps — MACHINE_RESET_MEMBER(decocass_type1_state,ctisland3) (decocass_m.cpp:1563-1570):
  m_type1_map = type1_latch_ctisland3 (LATCHINV,PROM,PROM,DIRECT,PROM,PROM,LATCH,PROM), inmap=outmap=
  MAKE_MAP(0,1,2,3,4,5,6,7) [= identity, comment: "correct for handcrafted prom"]. NEW dongle_type1.v
  case added this session: game_id=17 (0x11) — ctisland3 has no canonical MAME release-number comment
  (handcrafted variant), so 17 was picked as the free slot between ctisland(16)/cexplore(18).

  Same decocrom mechanism + SAME user3 ROM chips (deco-ti.x1-x4) as ctisland/ctisland2 — see
  "Treasure Island (US) (set 1) (DECO).mra" for the full decocrom writeup.

  index 1: Type-1 dongle PROM (ctisland3.pro, 32 B, handcrafted — DIFFERENT from set 1/2's de-0061.pro).
  index 2: decocrom overlay-PCB ROM (deco-ti.x1..x4, 16 KB — SAME chips as set 1/2).
-->
<misterromdescription>
    <name>Treasure Island (Europe)</name>
    <setname>ctisland3</setname>
    <rbf>DECOCassette</rbf>
    <mameversion>0268</mameversion>
    <year>1981</year>
    <manufacturer>Data East Corporation</manufacturer>
    <category>Action</category>

  	<rotation>vertical (ccw)</rotation>

    <rom index="0" zip="decocass.zip|ctisland3.zip" md5="none">
        <!-- $00000-$00FFF: Main 6502 BIOS (BIOS D / Europe — required for this set) -->
        <part name="v0d-.7e" crc="1e0c22b1"/>

        <!-- $01000-$017FF: Audio 6502 BIOS -->
        <part name="v1-.5a" crc="b66b2c2a"/>

        <!-- $01800-$01BFF: MCU ROM -->
        <part name="cassmcu.1c" crc="a6df18fd"/>

        <!-- $01C00-$01CFF: BIOS PROMs (96 B + 160 B pad) -->
        <part name="v2.3m"  crc="238fdb40"/>
        <part name="v4.10d" crc="3b5836b4"/>
        <part name="v3.3j"  crc="51eef657"/>
        <part repeat="0xA0">00</part>

        <!-- $01D00-$02CFF: legacy 4 KB dongle PROM region (unused; dongle moved to ioctl index 1; zeros) -->
        <part repeat="0x1000">00</part>

        <!-- $02D00-$02DFF: Spare -->
        <part repeat="0x100">00</part>

        <!-- $02E00-$02EFF: Metadata (Type 1, game_id=11 hex = 17 dec (assigned, no canonical MAME
             release number for this handcrafted variant), swap_mode unused) -->
        <part>01 11 00</part>
        <part repeat="0xFD">00</part>

        <!-- $02F00-$02FFF: Reserved -->
        <part repeat="0x100">00</part>

        <!-- $03000-: Cassette image -->
        <part name="ctislnd3.cas" crc="45464e1e"/>
    </rom>

    <rom index="1" zip="decocass.zip|ctisland3.zip" md5="none">
        <part name="ctisland3.pro" crc="b87b56a7"/>
    </rom>

    <rom index="2" zip="decocass.zip|ctisland3.zip" md5="none">
        <part name="deco-ti.x1" crc="a7f8aeba"/>
        <part name="deco-ti.x2" crc="2a0d3c91"/>
        <part name="deco-ti.x3" crc="3a26b97c"/>
        <part name="deco-ti.x4" crc="1cbe43de"/>
    </rom>

    <!-- Same DSW2 Lives/Bonus-Life overrides as ctisland/ctisland2 (4th GAME() param = "ctisland" input
         port for all three Treasure Island sets, decocass.cpp:2151-2153). -->
    <switches default="00,00,FF,3F">
        <dip bits="16"    name="Lives"      ids="5,3"/>
        <dip bits="17,18" name="Bonus Life" ids="15000,20000,25000,30000"/>
        <dip bits="21,23" name="Country Code" ids="inv,inv,F,E,D,C,B,A"/>
        <dip bits="24,25" name="Coin A" ids="2C/1C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="26,27" name="Coin B" ids="2C/1C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="28,29" name="Type of Tape" ids="MT Big,inv,inv,MD Small"/>
        <dip bits="30" name="Cabinet" ids="Upright,Cocktail"/>
    </switches>

    <buttons names="Button1,Button2,Coin,Start 1P,Start 2P,Pause" default="A,B,Select,Start,R,L"/>
</misterromdescription>
