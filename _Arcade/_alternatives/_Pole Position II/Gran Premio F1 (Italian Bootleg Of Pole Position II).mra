<misterromdescription>
    <name>Gran Premio F1 (Italian Bootleg Of Pole Position II)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Pole Position</series>
    <year>1984</year>
    <manufacturer>bootleg</manufacturer>
    <category>Driving</category>

    <setname>polepos2bi</setname>
    <parent>polepos2</parent>
    <mameversion>0289</mameversion>
    <rbf>PolePosition</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>no</flip>

    <players>1</players>
    <buttons names="Accelerate,Brake,Gear,Service Mode,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <!-- Index 0: ROM -->
    <rom index="0" md5="none" zip="polepos2bi.zip|polepos2.zip">
        <part crc="1a6412a1" name="5ita.bin"/>
        <part crc="e7362148" name="6ita.bin"/>
        <interleave output="16">
            <part crc="2856d5b1" name="18.bin" map="01"/>
            <part crc="41da3c28" name="19.bin" map="10"/>
        </interleave>
        <part repeat="16384">00</part>
        <interleave output="16">
            <part crc="fe9baeb6" name="4.bin" map="01"/>
            <part crc="6c823932" name="17.bin" map="10"/>
        </interleave>
    </rom>

    <!-- Index 1: ROM -->
