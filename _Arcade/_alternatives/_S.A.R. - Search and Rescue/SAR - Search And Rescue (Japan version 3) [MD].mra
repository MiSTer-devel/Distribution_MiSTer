<misterromdescription>
    <name>SAR - Search And Rescue (Japan version 3)</name>
    <setname>searcharj</setname>
    <parent>searchar</parent>
    <rbf>SNK68MD</rbf>
    <mameversion>0288</mameversion>
    <year>1989</year>
    <manufacturer>SNK</manufacturer>
    <players>2</players>
    <joystick>Rotary</joystick>
    <rotation>vertical (cw)</rotation>
    <region>Japan</region>

    <switches default="ff,ff">
        <!-- DSW1 -->
        <dip name="Joystick" bits="0" ids="Rotary Joystick,Standard Joystick" values="1,0"/>
        <dip name="Unknown" bits="1" ids="Off,On" values="1,0"/>
        <dip name="Lives" bits="2,3" ids="2,3,4,5" values="1,3,2,0"/>
        <dip name="Coinage" bits="4,5" ids="A 4/1 B 1/4,A 3/1 B 1/3,A 2/1 B 1/2,1 Coin/1 Credit" values="0,2,1,3"/>
        <dip name="Bonus Occur" bits="6" ids="1st+2nd only,1st+every 2nd" values="1,0"/>
        <dip name="Flip Screen" bits="7" ids="Off,On" values="1,0"/>
        <!-- DSW2 -->
        <dip name="Service Mode" bits="8" ids="Off,On" values="1,0"/>
        <dip name="Allow Continue" bits="9" ids="No,Yes" values="0,1"/>
        <dip name="Bonus Life" bits="10,11" ids="50k 100k,70k 140k,90k 180k,None" values="3,1,2,0"/>
        <dip name="Game Mode" bits="12,13" ids="Demo Sounds Off,Demo Sounds On,Freeze,Inf Lives (Cheat)" values="1,3,0,2"/>
        <dip name="Difficulty" bits="14,15" ids="Easy,Normal,Hard,Hardest" values="1,3,2,0"/>
    </switches>

    <buttons names="Fire/Power,Jump,-,Rotate CW,Rotate CCW,Start,Coin,Pause,Save States" default="A,B,X,Y,Start,Select,R,L"/>

    <rom index="1">
        <part>00 01</part>
    </rom>

    <rom index="0" zip="searcharj.zip|searchar.zip" md5="None">
        <!-- maincpu - starts at 0x0 -->
        <interleave output="16">
            <part name="bh2ver3j.9c" crc="7ef7b172" map="01"/>
            <part name="bh3ver3j.10c" crc="3fdea793" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="bhw.1" crc="62b60066" map="01"/>
            <part name="bhw.4" crc="16d8525c" map="10"/>
        </interleave>
        <!-- soundcpu - starts at 0x80000 -->
        <part name="bh.5" crc="53e2fa76"/>
        <part repeat="0x10000"> FF</part>
        <!-- upd - starts at 0xA0000 -->
        <part name="bh.v1" crc="07a6114b"/>
        <!-- gfx1 - starts at 0xC0000 -->
        <interleave output="16">
            <part name="bh.7" crc="b0f1b049" map="01"/>
            <part name="bh.8" crc="174ddba7" map="10"/>
        </interleave>
        <part repeat="0x30000"> FF</part>
        <!-- gfx2 - starts at 0x100000 -->
        <interleave output="32">
            <part name="bh.c1" crc="1fb8f0ae" map="0021"/>
            <part name="bh.c2" crc="7c803767" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="bh.c3" crc="fd8bc407" map="0021"/>
            <part name="bh.c4" crc="eede7c43" map="2100"/>
        </interleave>
        <interleave output="32">
            <part name="bh.c5" crc="1d30acc3" map="0021"/>
            <part name="bh.c6" crc="9f785cd9" map="2100"/>
        </interleave>
        <!-- Total 0x400000 bytes - 4096 kBytes -->
    </rom>

    <!-- hiscore: address[4] length[2] start end, MAME 0.288 plugins/hiscore/hiscore.dat -->
    <rom index="3" md5="none">
        <part>
            00 04 37 B6 00 50 00 1F
            00 04 01 18 00 03 00 01
        </part>
    </rom>
    <nvram index="4" size="83"/>
</misterromdescription>
