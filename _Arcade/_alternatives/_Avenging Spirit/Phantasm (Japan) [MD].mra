<misterromdescription>
    <name>Phantasm (Japan)</name>
    <setname>phantasm</setname>
    <rbf>MegaSys1_AMD</rbf>
    <mameversion>0288</mameversion>
    <year>1990</year>
    <manufacturer>Jaleco</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>

    <!-- DIP switches: MAME 0.288 -listxml -->
    <switches default="FF,FD">
        <dip name="Coin A" bits="0,3" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/1Cr,2C/3Cr,1C/2Cr,1C/3Cr,1C/4Cr,1C/5Cr,1C/6Cr,Free Play" values="7,8,9,15,6,14,13,12,11,10,0"/>
        <dip name="Coin B" bits="4,7" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/1Cr,2C/3Cr,1C/2Cr,1C/3Cr,1C/4Cr,1C/5Cr,1C/6Cr,Free Play" values="7,8,9,15,6,14,13,12,11,10,0"/>
        <dip name="Flip Screen" bits="8" ids="Off,On" values="1,0"/>
        <dip name="Demo Sounds" bits="9" ids="Off,On" values="1,0"/>
        <dip name="Allow Continue" bits="10" ids="Off,On" values="0,1"/>
        <dip name="Difficulty" bits="11,12" ids="Easy,Normal,Hard,Hardest" values="1,3,2,0"/>
        <dip name="Cabinet" bits="13" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Test Mode" bits="14" ids="Off,On" values="1,0"/>
        <dip name="Service Mode" bits="15" ids="Off,On" values="1,0"/>
    </switches>

    <!-- button names: va7deo MRAs -->
    <buttons names="Attack,Jump,-,Start,Coin,Pause,Save/Load" default="A,B,Start,Select,R,L"/>

    <rom index="1">
        <part>02</part>
    </rom>

    <rom index="2">
        <part>
            00 01 04 32   00 00 14 32   00 01 43 02   00 00 43 12
            00 01 04 23   00 00 14 23   00 04 13 02   00 04 03 12
            00 02 41 03   00 02 40 13   00 02 41 30   00 02 40 31
            00 01 30 42   00 00 31 42   00 01 40 32   00 00 41 32
        </part>
    </rom>

    <rom index="3">
        <part>10</part>
    </rom>

    <rom index="0" zip="phantasm.zip|avspirit.zip" md5="none">
        <!-- maincpu - starts at 0x0 -->
        <interleave output="16">
            <part name="phntsm02.bin" crc="d96a3584" map="01"/>
            <part name="phntsm01.bin" crc="a54b4b87" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="phntsm03.bin" crc="1d96ce20" map="01"/>
            <part name="phntsm04.bin" crc="dc0c4994" map="10"/>
        </interleave>
        <part repeat="0x20000">FF</part>

        <!-- audiocpu - starts at 0x80000 -->
        <interleave output="16">
            <part name="phntsm05.bin" crc="3b169b4a" map="01"/>
            <part name="phntsm06.bin" crc="df2dfb2e" map="10"/>
        </interleave>
        <part repeat="0x60000">FF</part>

        <!-- oki1 - starts at 0x100000 -->
        <part name="spirit14.rom" crc="13be9979"/>
        <part repeat="0xc0000">FF</part>

        <!-- oki2 - starts at 0x200000 -->
        <part name="spirit13.rom" crc="05bc04d9"/>
        <part repeat="0x40000">FF</part>

        <!-- scroll1 - starts at 0x280000 -->
        <part name="spirit12.rom" crc="728335d4"/>

        <!-- scroll2 - starts at 0x300000 -->
        <part name="spirit11.rom" crc="7896f6b0"/>

        <!-- scroll3 - starts at 0x380000 -->
        <part name="spirit09.rom" crc="0c37edf7"/>
        <part repeat="0x60000">FF</part>

        <!-- sprites - starts at 0x400000 -->
        <part name="spirit10.rom" crc="2b1180b3"/>
        <part repeat="0x80000">FF</part>

        <!-- proms - starts at 0x500000 -->
        <part name="ph.14m" crc="8359650a"/>

    </rom>

    <!-- hiscore table: address[4], length[2], start byte, end byte - MAME 0.288 plugins/hiscore/hiscore.dat -->
    <rom index="4" md5="none">
        <part>
            00 0F 9D EE 00 53 00 54
        </part>
    </rom>
    <nvram index="5" size="83"/>
</misterromdescription>
