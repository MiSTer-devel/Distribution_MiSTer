<misterromdescription>
    <name>Pole Position (Atari version 1 on Namco PCB)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Pole Position</series>
    <year>1982</year>
    <manufacturer>Namco (Atari license)</manufacturer>
    <category>Driving</category>

    <setname>poleposa1n</setname>
    <parent>polepos</parent>
    <mameversion>0289</mameversion>
    <rbf>PolePosition</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>horizontal</rotation>
    <flip>no</flip>

    <players>1</players>
    <buttons names="Accelerate,Brake,Gear,Service Mode,Coin,Start 1P,Start 2P,Pause" default="A,B,X,Y,Select,Start,R,L"/>

    <rom index="0" md5="none" zip="poleposa1n.zip|polepos.zip">
        <!-- maincpu (Z80) 0x0000-0x2FFF -->
        <part crc="c918c043" name="pp2_9.6h"/>
        <part crc="7174bcb7" name="pp2_10.5h"/>
        <!-- sub1 (Z8002 #1), ROM_LOAD16_BYTE: even=HIGH=.8l, odd=LOW=.8m -->
        <interleave output="16">
            <part crc="51018857" name="pp2_2.8l" map="01"/>
            <part crc="8c2cf172" name="pp2_1.8m" map="10"/>
        </interleave>
        <part repeat="16384">00</part>
        <!-- sub2 (Z8002 #2) -->
        <interleave output="16">
            <part crc="ba0045f3" name="pp2_6.4l" map="01"/>
            <part crc="af4fc019" name="pp2_5.4m" map="10"/>
        </interleave>
        <part repeat="16384">00</part>
    </rom>

    <rom index="1" md5="none" zip="poleposa1n.zip|polepos.zip">
        <!-- chars / tiles / sprites / bigsprites(GAP) / road / scalelut -->
        <part crc="a949aa85" name="pp2_28.1f"/>
        <part crc="a949aa85" name="pp2_28.1f"/>
        <part crc="706e888a" name="pp1_29.1e"/>
        <part crc="706e888a" name="pp1_29.1e"/>
        <part crc="34c2d310" name="pp2_25.1n"/>
        <part crc="ba3005f3" name="pp2_26.1m"/>
        <part crc="2e134b46" name="pp2_17.5n"/>
        <part crc="1c5c05b7" name="pp2_19.4n"/>
        <part crc="020f4de5" name="pp2_21.3n"/>
        <part repeat="8192">00</part>
        <part crc="6f9997d2" name="pp2_18.5m"/>
        <part crc="b8a0411c" name="pp2_20.4m"/>
        <part crc="4fbf3e94" name="pp2_22.3m"/>
        <part repeat="8192">00</part>
        <part crc="ee6b3315" name="pp1_30.3a"/>
        <part crc="6d1e7042" name="pp1_31.2a"/>
        <part crc="4e97f101" name="pp1_32.1a"/>
        <part crc="a61bff15" name="pp1_27.1l"/>
    </rom>

    <rom index="2" md5="none" zip="poleposa1n.zip|polepos.zip">
        <part crc="f07ff2ad" name="pp1-7.8l"/>
        <part crc="adbde7d7" name="pp1-8.9l"/>
        <part crc="ddac786a" name="pp1-9.10l"/>
        <part crc="1e8d0491" name="pp2-10.2h"/>
        <part crc="0e4fe8a0" name="pp1-11.4d"/>
        <part crc="2d502464" name="pp1-15.9a"/>
        <part crc="027aa62c" name="pp1-16.10a"/>
        <part crc="1f8d0df3" name="pp1-17.11a"/>
        <part crc="7afc7cfc" name="pp1-12.3c"/>
        <part crc="b448c934" name="pp2-6.6m"/>
        <part crc="4330a51b" name="pp1-13.8e"/>
        <part crc="4330a51b" name="pp1-14.9e"/>
        <part crc="8568decc" name="136014-118.11d"/>
        <part crc="2401c817" name="136014-117.7l"/>
    </rom>

    <!-- Index 3: hiscore config -->
    <rom index="3" md5="none">
        <part>
        01 FF FF FF 00 FF 00 02 00 02 00 01 00 FF 00 00
        00 00 30 00 07 F2 B0 95
        </part>
    </rom>

    <!-- Index 4: nvram config -->
    <rom index="4"></rom>
    <nvram index="4" size="2034"></nvram>

    <rom index="5" md5="none" zip="poleposa1n.zip|polepos.zip">
        <!-- engine sound, then 52xx voice padded to 0x8000 -->
        <part crc="b5ad4d5f" name="136014-110.12f"/>
        <part crc="8fdd2f6f" name="136014-111.12e"/>
        <part crc="5b4cf05e" name="136014-106.9c"/>
        <part repeat="24576">00</part>
    </rom>

    <rom index="6" md5="none" zip="namco51.zip|namco52.zip|namco53.zip|namco54.zip">
        <part crc="c2f57ef8" name="51xx.bin"/>
        <part crc="b326fecb" name="53xx.bin"/>
        <part crc="ee7357e0" name="54xx.bin"/>
        <part crc="3257d11e" name="52xx.bin"/>
    </rom>

    <switches default="FF,74" base="0">
        <!-- DSWA -->
        <dip name="Coin A"        bits="5,7"   ids="Free Play,2C/1C,3C/2C,1C/2C,4C/3C,1C/3C,3C/1C,1C/1C"/>
        <dip name="Coin B"        bits="3,4"   ids="4C/3C,2C/1C,3C/2C,1C/1C"/>
        <dip name="Game Time"     bits="1,2"   ids="120 secs,100 secs,110 secs,90 secs"/>
        <dip name="Racing Laps"   bits="0,0"   ids="4,3"/>
        <!-- DSWB -->
        <dip name="Practice Rank" bits="13,15" ids="H,D,F,B,G,C,E,A"/>
        <dip name="Extended Rank" bits="10,12" ids="H,D,F,B,G,C,E,A"/>
        <dip name="Speed Unit"    bits="9,9"   ids="mph,km/h"/>
        <dip name="Demo Sounds"   bits="8,8"   ids="On,Off"/>
    </switches>

    <remark>Pole Position (Atari, version 1 on Namco PCB)</remark>
    <mratimestamp>20260921000000</mratimestamp>
</misterromdescription>
