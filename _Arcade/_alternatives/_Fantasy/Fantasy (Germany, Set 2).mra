        <part crc="371129fe" name="fs8.bin"/>
        <part crc="49574d4a" name="fs9.bin"/>
        <part repeat="0x3000">00</part>
        <part crc="e5b91bc2" name="fs6.bin"/>
        <part crc="86a801c3" name="fs10.bin"/>
        <part crc="9dfff71c" name="fs11.bin"/>
        <part crc="361a5e99" name="fantasy.ic7"/>
        <part crc="33d974f7" name="fantasy.ic6"/>
        <part crc="48094ec5" name="fs_b_51.bin"/>
        <part crc="1d0316e8" name="fs_a_52.bin"/>
        <part crc="49fd4ae8" name="fs_c_53.bin"/>
        <part repeat="0x7C0">00</part>
