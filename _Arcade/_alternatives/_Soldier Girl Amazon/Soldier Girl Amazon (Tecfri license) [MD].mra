<misterromdescription>
  <name>Soldier Girl Amazon (Tecfri license)</name>
  <mameversion>0288</mameversion>
  <setname>amazont</setname>
  <year>1986</year>
  <manufacturer>Nichibutsu (Tecfri license)</manufacturer>
  <category>Shoot 'em up</category>
  <rotation>vertical (ccw)</rotation>
  <parent>amazon</parent>
  <rbf>TerraCrestaMD</rbf>

  <switches default="df,ff,ff,ff">
    <!-- IN2 -->
    <dip name="Service Mode" bits="29" ids="Off,On" values="1,0"/>
    <!-- IN3 -->
    <dip name="Lives" bits="0,1" ids="3,4,5,6" values="3,2,1,0"/>
    <dip name="Bonus Life" bits="2,3" ids="20k/every 40k,50k/every 40k,20k/every 70k,50k/every 70k" values="3,2,1,0"/>
    <dip name="Demo Sounds" bits="4" ids="Off,On" values="0,1"/>
    <dip name="Cabinet" bits="5" ids="Upright,Cocktail" values="0,1"/>
    <dip name="Unused" bits="6" ids="Off,On" values="1,0"/>
    <dip name="Debug Mode" bits="7" ids="Off,On" values="1,0"/>
    <dip name="Coin A" bits="8,9" ids="2 Coins/1 Credit,1 Coin/1 Credit,1 Coin/2 Credits,Free Play" values="1,3,2,0"/>
    <dip name="Coin B" bits="10,11" ids="3 Coins/1 Credit,1 Coin/1 Credit,2 Coins/3 Credits,1 Coin/3 Credits" values="0,2,1,3"/>
    <dip name="Difficulty" bits="12" ids="Easy,Hard" values="1,0"/>
    <dip name="Flip Screen" bits="13" ids="Off,On" values="1,0"/>
    <dip name="Level" bits="14" ids="Low,High" values="1,0"/>
    <dip name="Sprite Test" bits="15" ids="Off,On" values="1,0"/>
  </switches>

  <buttons names="Sword Beam,Stop Bullet,Start,Coin,Pause,Save/Load" default="A,B,Start,Select,R,L"/>

  <rom index="0" zip="amazont.zip|amazon.zip" md5="f1c65ebc7d68c5235ac81402642646cd">
    <!-- maincpu - starts at 0x0 -->
    <interleave output="16">
      <part name="7.4b" crc="a74cdcea" map="01"/>
      <part name="5.4d" crc="ae39432f" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="6.6b" crc="edbaad3f" map="01"/>
      <part name="4.6d" crc="0c6b0772" map="10"/>
    </interleave>

    <!-- bgtiles - starts at 0x20000 -->
    <part name="13.15f" crc="415ff4d9"/>
    <part name="14.17f" crc="492b5c48"/>
    <part name="15.18f" crc="b1ac0b9d"/>
    <part repeat="0x8000">FF</part>

    <!-- sprites - starts at 0x40000 -->
    <part name="4.6e" crc="f77ced7a"/>
    <part name="5.7e" crc="16ef1465"/>
    <part name="6.6g" crc="936ec941"/>
    <part name="7.7g" crc="66dd718e"/>
    <part repeat="0x10000">FF</part>

    <!-- fgtiles - starts at 0x60000 -->
    <part name="8.16g" crc="0cec8644"/>
    <part repeat="0xe000">FF</part>

    <!-- audiocpu - starts at 0x70000 -->
    <part name="1.15b" crc="55a8b5e7"/>
    <part name="2.17b" crc="427a7cca"/>
    <part name="3.18b" crc="b8cceaf7"/>

    <!-- prot_chip - starts at 0x7c000 -->
    <part name="16.18g" crc="1d8d592b"/>

    <!-- proms - starts at 0x7e000 -->
    <part name="clr.10f" crc="6440b341"/>
    <part name="clr.11f" crc="271e947f"/>
    <part name="clr.12f" crc="7d38621b"/>
    <part name="2g" crc="44ca16b9"/>

    <!-- palbank_prom - starts at 0x7e400 -->
    <part name="4e" crc="035f2c7b"/>

    <!-- Total 0x7e500 bytes -->
  </rom>

  <!-- game select (pcb) -->
  <rom index="1">
    <part>03</part>
  </rom>

  <!-- hiscore table: address[4], length[2], start byte, end byte - MAME 0.288 plugins/hiscore/hiscore.dat -->
  <rom index="3" md5="none">
    <part>
      00 04 0D B4 00 46 00 0E
      00 04 0D 66 00 04 00 00
      00 04 0D 68 00 01 50 50
    </part>
  </rom>
  <nvram index="4" size="75"/>
</misterromdescription>
