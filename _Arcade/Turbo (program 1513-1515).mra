	<about></about>

	<resolution>15kHz</resolution>
	<rotation>vertical (ccw)</rotation>
	<flip>no</flip>

	<players>1</players>
	<joystick>analog</joystick>
	<special_controls>steering wheel (dial), accelerator pedal, gear shift</special_controls>
	<num_buttons>2</num_buttons>
	<button_names>Gear Shift,Pedal</button_names>

	<buttons names="-,-,-,Start,Coin,Gear Shift,Pedal" default="Start,Select,Y,A"></buttons>
	<switches default="EF,FF,B0">
		<dip bits="0,1" name="Lives" ids="2,3,4,5"/>
		<dip bits="2" name="Game Time" ids="Fixed (55 sec),Adjustable"/>
		<dip bits="3" name="Difficulty" ids="Hard,Easy"/>
		<dip bits="4" name="Collisions" ids="On,Off (Cheat)"/>
		<dip bits="5" name="Initial Entry" ids="Off,On"/>
		<dip bits="8,9" name="Game Time" ids="60s,70s,80s,90s"/>
		<dip bits="10,11,12" name="Coin B" ids="1C_1C,1C_2C,1C_3C,1C_6C,2C_1C,3C_1C,4C_1C,1C_1C"/>
		<dip bits="13,14,15" name="Coin A" ids="1C_1C,1C_2C,1C_3C,1C_6C,2C_1C,3C_1C,4C_1C,1C_1C"/>
		<dip bits="22" name="Tachometer" ids="Digital (LED),Analog (Meter)"/>
		<dip bits="23" name="Sound System" ids="Cockpit,Upright"/>
	</switches>
	<rom index="1"><part>01</part></rom>
