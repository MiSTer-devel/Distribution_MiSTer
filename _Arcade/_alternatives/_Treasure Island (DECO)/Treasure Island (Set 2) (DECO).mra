<?xml version="1.0" encoding="UTF-8"?>
<!--
  Treasure Island (US) (set 2) (ctisland2) — Type 1 Dongle, decocrom overlay-PCB ROM

  Per MAME decocass.cpp: GAME(1981, ctisland2, ctisland, ctisland, ctisland, decocass_type1_state,
  init_decocrom, ROT270, "Data East Corporation", "Treasure Island (DECO Cassette) (US) (set 2)", 0)
  — "newer? has instructions in attract" (source comment, line 2152). Same machine_config as ctisland
  (MACHINE_RESET_MEMBER(decocass_type1_state,ctisland), same game_id=16, same DSW2 overrides) — only
  the cassette image differs. See "Treasure Island (US) (set 1) (DECO).mra" for the full mechanism
  writeup (decocrom banking, dongle config, region map).

  index 1: Type-1 dongle PROM (de-0061.pro, 32 B — SAME dongle as set 1).
  index 2: decocrom overlay-PCB ROM (deco-ti.x1..x4, 16 KB — SAME chips as set 1).
-->
<misterromdescription>
    <name>Treasure Island (US) (set 2)</name>
    <setname>ctisland2</setname>
    <rbf>DECOCassette</rbf>
    <mameversion>0268</mameversion>
    <year>1981</year>
    <manufacturer>Data East Corporation</manufacturer>
    <category>Action</category>

  	<rotation>vertical (ccw)</rotation>

    <rom index="0" zip="decocass.zip|ctisland2.zip" md5="none">
        <!-- $00000-$00FFF: Main 6502 BIOS (BIOS B / USA) -->
        <part name="v0b-.7e" crc="23d929b7"/>

        <!-- $01000-$017FF: Audio 6502 BIOS -->
        <part name="v1-.5a" crc="b66b2c2a"/>

        <!-- $01800-$01BFF: MCU ROM -->
        <part name="cassmcu.1c" crc="a6df18fd"/>

        <!-- $01C00-$01CFF: BIOS PROMs (96 B + 160 B pad) -->
        <part name="v2.3m"  crc="238fdb40"/>
        <part name="v4.10d" crc="3b5836b4"/>
        <part name="v3.3j"  crc="51eef657"/>
        <part repeat="0xA0">00</part>

        <!-- $01D00-$02CFF: legacy 4 KB dongle PROM region (unused; dongle moved to ioctl index 1; zeros) -->
        <part repeat="0x1000">00</part>

        <!-- $02D00-$02DFF: Spare -->
        <part repeat="0x100">00</part>

        <!-- $02E00-$02EFF: Metadata (Type 1, game_id=10 hex = DECO release 16, swap_mode unused) -->
        <part>01 10 00</part>
        <part repeat="0xFD">00</part>

        <!-- $02F00-$02FFF: Reserved -->
        <part repeat="0x100">00</part>

        <!-- $03000-: Cassette image -->
        <part name="ctislnd2.cas" crc="2854b4c0"/>
    </rom>

    <rom index="1" zip="decocass.zip|ctisland2.zip" md5="none">
        <part name="de-0061.pro" crc="e09ae5de"/>
    </rom>

    <rom index="2" zip="decocass.zip|ctisland2.zip" md5="none">
        <part name="deco-ti.x1" crc="a7f8aeba"/>
        <part name="deco-ti.x2" crc="2a0d3c91"/>
        <part name="deco-ti.x3" crc="3a26b97c"/>
        <part name="deco-ti.x4" crc="1cbe43de"/>
    </rom>

    <switches default="00,00,FF,3F">
        <dip bits="16"    name="Lives"      ids="5,3"/>
        <dip bits="17,18" name="Bonus Life" ids="15000,20000,25000,30000"/>
        <dip bits="21,23" name="Country Code" ids="inv,inv,F,E,D,C,B,A"/>
        <dip bits="24,25" name="Coin A" ids="2C/1C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="26,27" name="Coin B" ids="2C/1C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="28,29" name="Type of Tape" ids="MT Big,inv,inv,MD Small"/>
        <dip bits="30" name="Cabinet" ids="Upright,Cocktail"/>
    </switches>

    <buttons names="Button1,Button2,Coin,Start 1P,Start 2P,Pause" default="A,B,Select,Start,R,L"/>
</misterromdescription>
