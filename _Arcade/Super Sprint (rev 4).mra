<misterromdescription>
	<name>Super Sprint (rev 4)</name>
	<setname>ssprint</setname>
	<mratimestamp>20260803000000</mratimestamp>
	<year>1986</year>
	<manufacturer>Atari Games</manufacturer>
	<rotation>horizontal</rotation>
	<category>Arcade</category>
	<rbf>atarisys2</rbf>
	<mameinfo parent="ssprint" cpp="atarisy2" input="ssprint"/>
	<display type="raster" rotate="0"/>

	<!-- Button order MUST match the core's CONF_STR J1 (atarisys2.sv):
	     MiSTer assigns these names to joystick_0[4],[5],[6]... IN ORDER, and an MRA
	     name list overrides the OSD labels, so a mismatch silently drives the wrong
	     core bit. -->
	<buttons names="Gas,-,Coin,Service Credit,Start,-" default="A,R,L,X"/>

	<!-- Game descriptor, 4 bytes (rtl/rom/sys2_rom_layout.vh):
	       [0] slapstic type  108
	       [1] game id        2
	       [2] flags          bit0 = TMS5220 populated -> 0x00
	       [3] reserved       0
	     The core validates all four AND checks the slapstic type against the game id,
	     holding the T-11 in reset if they disagree. A pre-v2 MRA carrying only the
	     single slapstic byte is rejected on that path. -->
	<rom index="1">
		<part>6C 02 00 00</part>
	</rom>

	<!-- Fixed stream contract. Generated from the ROM manifest; the layout it
	     targets is rtl/rom/sys2_rom_layout.vh. -->
	<rom index="0" zip="ssprint.zip" md5="none">
		<!-- maincpu: stream 0x000000-0x08ffff, region 0x90000 -->
		<part repeat="32768">FF</part>
		<interleave output="16">
			<part name="136042-330.7l" crc="ee312027" map="01"/>
			<part name="136042-331.7n" crc="2ef15354" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="136042-329.6f" crc="ed1d6205" map="01"/>
			<part name="136042-325.6n" crc="aecaa2bf" map="10"/>
		</interleave>
		<part repeat="196608">FF</part>
		<interleave output="16">
			<part name="136042-127.6k" crc="de6c4db9" map="01"/>
			<part name="136042-123.6r" crc="aff23b5a" map="10"/>
		</interleave>
		<part repeat="65536">FF</part>
		<interleave output="16">
			<part name="136042-126.6l" crc="92f5392c" map="01"/>
			<part name="136042-122.6s" crc="0381f362" map="10"/>
		</interleave>
		<part repeat="65536">FF</part>

		<!-- audiocpu: stream 0x090000-0x09ffff, region 0x10000 -->
		<part repeat="32768">FF</part>
		<part name="136042-419.2bc" crc="b277915a"/>
		<part name="136042-420.2d" crc="170b2c53"/>

		<!-- tiles: stream 0x0a0000-0x11ffff, region 0x80000 -->
		<!-- The two RGN_FRAC(1,2) plane halves of MAME's region (split at 0x40000) are
		     byte-interleaved here, so one 16-bit word is {high-plane byte,
		     low-plane byte}. That is the pair both tile readers want, which lets
		     the loader stay a straight byte-through map. -->
		<interleave output="16">
			<part name="136042-105.6a" crc="911499fe" offset="0x8000" length="0x8000" map="01"/>
			<part name="136042-107.6c" crc="b7ded658" offset="0x8000" length="0x8000" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="136042-106.6b" crc="a39b25ed" map="01"/>
			<part name="136042-108.6de" crc="4a804a4c" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="136042-101.7a" crc="6d015c72" offset="0x8000" length="0x8000" map="01"/>
			<part name="136042-104.7de" crc="339644ed" offset="0x8000" length="0x8000" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="136042-102.7b" crc="54e21f0a" map="01"/>
			<part name="136042-103.7c" crc="64d473a8" map="10"/>
		</interleave>
		<interleave output="16">
			<part name="136042-105.6a" crc="911499fe" offset="0x0" length="0x8000" map="01"/>
			<part name="136042-107.6c" crc="b7ded658" offset="0x0" length="0x8000" map="10"/>
		</interleave>
		<part repeat="65536">FF</part>
		<interleave output="16">
			<part name="136042-101.7a" crc="6d015c72" offset="0x0" length="0x8000" map="01"/>
			<part name="136042-104.7de" crc="339644ed" offset="0x0" length="0x8000" map="10"/>
		</interleave>
		<part repeat="65536">FF</part>

		<!-- sprites: stream 0x120000-0x21ffff, region 0x100000 -->
		<part name="136042-113.6l" crc="f869b0fc"/>
		<part name="136042-112.6k" crc="abcbc114"/>
		<part name="136042-110.6jh" crc="9e91e734"/>
		<part name="136042-109.6fh" crc="3a051f36"/>
		<part name="136042-117.6rs" crc="b15c1b90"/>
		<part name="136042-116.6pr" crc="1dcdd5aa"/>
		<part name="136042-115.6n" crc="fb5677d9"/>
		<part name="136042-114.6m" crc="35e70a8d"/>
		<part repeat="786432">FF</part>

		<!-- chars: stream 0x220000-0x223fff, region 0x4000 -->
		<part name="136042-118.6t" crc="8489d113"/>

		<!-- eeprom: stream 0x224000-0x2241ff, region 0x200 -->
		<part name="ssprint-eeprom.bin" crc="9301ed27"/>
	</rom>

	<!-- 2804 EEPROM save-back: settings and high scores persist across power
	     cycles. Restored after the factory default in the stream above. -->
	<nvram index="2" size="512"/>
</misterromdescription>
