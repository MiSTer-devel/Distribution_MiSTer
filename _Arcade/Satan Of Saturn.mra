<misterromdescription>
    <name>Satan Of Saturn</name>
    <setname>satansat</setname>
    <rbf>SNK6502</rbf>
    <mameversion>0261</mameversion>
    <year>1980</year>
    <manufacturer>SNK</manufacturer>
    <players>1</players>
    <joystick>2-way</joystick>
    <rotation>vertical (cw)</rotation>
    <region>World</region>
    <category>Shooter</category>

    <switches default="15" base="16">
        <dip name="Cabinet" bits="0" ids="Cocktail,Upright"/>
        <dip name="Coinage (SW1:2)" bits="1" ids="1C/1C,1C/2C"/>
        <dip name="Bonus Life" bits="2" ids="10000,5000"/>
        <dip name="Coinage 2C/1C (SW1:4)" bits="3" ids="Off,On"/>
        <dip name="Lives" bits="4,5" ids="3,4,5,3"/>
        <dip name="Unused SW1:7" bits="6" ids="Off,On"/>
        <dip name="RAM Test" bits="7" ids="Off,On"/>
    </switches>

    <buttons names="Fire,-,-,-,Coin,Start 1P,Start 2P,Pause" default="A,Select,Start,R,L"/>

    <rom index="0" zip="satansat.zip" md5="none">
        <part repeat="0x4000">00</part>
        <part crc="549dd13a" name="ss1"/>
        <part crc="04972fa8" name="ss2"/>
        <part crc="9caf9057" name="ss3"/>
        <part crc="e1bdcfe1" name="ss4"/>
        <part crc="d454de19" name="ss5"/>
        <part crc="7fbd5d30" name="ss6"/>
        <part crc="93ea2df9" name="zarz128.15"/>
        <part crc="e67ec873" name="zarz129.16"/>
        <part crc="22c44650" name="zarz130.22"/>
        <part crc="8f1b313a" name="ss10"/>
        <part crc="e74f98e0" name="ss11"/>
        <part repeat="0x6000">00</part>
        <part crc="e67ec873" name="zarz129.16"/>
        <part crc="e837c62b" name="zarz135.73"/>
        <part repeat="0x0800">00</part>
        <part crc="83f61623" name="zarz136.75"/>
        <part repeat="0x0800">00</part>
        <part crc="5dd6933a" name="zarz138.03"/>
        <part repeat="0x0020">00</part>
        <part crc="dee01f24" name="ss12"/>
        <part crc="580934d2" name="zarz134.54"/>
    </rom>

    <!-- ROM index 1: game_id = 1 (GID_SATANSAT) -->
    <rom index="1">
