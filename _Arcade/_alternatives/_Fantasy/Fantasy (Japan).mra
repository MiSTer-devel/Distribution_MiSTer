<misterromdescription>
    <name>Fantasy (Japan)</name>
    <setname>fantasyj</setname>
    <parent>fantasyu</parent>
    <rbf>SNK6502</rbf>
    <mameversion>0289</mameversion>
    <year>1981</year>
    <manufacturer>SNK</manufacturer>
    <players>1</players>
    <joystick>4-way</joystick>
    <rotation>vertical (cw)</rotation>
    <region>World</region>
    <category>Shooter</category>

    <switches default="03" base="16">
        <dip name="Cabinet" bits="0" ids="Cocktail,Upright"/>
        <dip name="Coinage" bits="1,3" ids="1C/1C,2C/1C,1C/3C,1C/1C,1C/2C,1C/1C,1C/6C,1C/1C"/>
        <dip name="Lives" bits="4,5" ids="3,4,5,3"/>
        <dip name="Coinage Bonus" bits="6" ids="1C/1C,2C/1C"/>
        <dip name="Allow Continue" bits="7" ids="Yes,No"/>
    </switches>

    <buttons names="Fire,-,-,-,Coin,Start 1P,Start 2P,Pause" default="A,Select,Start,R,L"/>

    <rom index="0" zip="fantasyj.zip|fantasyu.zip" md5="none">
