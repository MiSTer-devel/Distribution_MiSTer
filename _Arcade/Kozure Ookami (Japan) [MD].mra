<misterromdescription>
  <name>Kozure Ookami (Japan)</name>
  <mameversion>0288</mameversion>
  <setname>kozure</setname>
  <year>1987</year>
  <manufacturer>Nichibutsu</manufacturer>
  <category>Beat 'em up</category>
  <rotation>horizontal</rotation>
  <rbf>ArmedFMD</rbf>

  <switches default="cf,ff">
    <!-- DSW1 -->
    <dip name="Lives" bits="0,1" ids="3,4,5,6" values="3,2,1,0"/>
    <dip name="Bonus Life" bits="2,3" ids="50k/every 60k,50k/every 90k,Every 60k,Every 90k" values="2,0,3,1"/>
    <dip name="Demo Sounds" bits="4" ids="Off,On" values="1,0"/>
    <dip name="Cabinet" bits="5" ids="Upright,Cocktail" values="0,1"/>
    <dip name="Difficulty" bits="6" ids="Easy,Hard" values="1,0"/>
    <dip name="Unused" bits="7" ids="Off,On" values="1,0"/>
    <!-- DSW2 -->
    <dip name="Coin A" bits="8,9" ids="2 Coins/1 Credit,1 Coin/1 Credit,1 Coin/2 Credits,Free Play" values="1,3,2,0"/>
    <dip name="Coin B" bits="10,11" ids="3 Coins/1 Credit,2 Coins/3 Credits,1 Coin/3 Credits,1 Coin/6 Credits" values="0,1,3,2"/>
    <dip name="Unused" bits="12" ids="Off,On" values="1,0"/>
    <dip name="Flip Screen" bits="13" ids="Off,On" values="1,0"/>
    <dip name="Allow Continue" bits="14" ids="No,Yes" values="0,1"/>
    <dip name="Infinite Timer (Cheat)" bits="15" ids="No,Yes" values="1,0"/>
  </switches>

  <buttons names="Slash,Block,-,-,Start,Coin,Pause,-,-,Save/Load" default="A,B,Start,Select,R,L"/>

  <rom index="0" zip="kozure.zip" md5="110443958813ecb6f73622a3ef965bdb">
    <!-- maincpu - starts at 0x0 -->
    <interleave output="16">
      <part name="kozure8.6e" crc="6bbfb1e6" map="01"/>
      <part name="kozure3.6h" crc="f9178ec8" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="kozure7.5e" crc="a7ee09bb" map="01"/>
      <part name="kozure2.5h" crc="236d820f" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="kozure6.3e" crc="9120e728" map="01"/>
      <part name="kozure1.3h" crc="345fe7a5" map="10"/>
    </interleave>
    <part repeat="0x20000">FF</part>

    <!-- foreground - starts at 0x80000 -->
    <part name="kozure5.15h" crc="0b510258"/>
    <part name="kozure4.14h" crc="fb8e13e6"/>
    <part repeat="0x10000">FF</part>

    <!-- background - starts at 0xc0000 -->
    <part name="kozure14.8a" crc="94a9c3d0"/>
    <part repeat="0x30000">FF</part>

    <!-- sprite - starts at 0x100000 -->
    <interleave output="16">
      <part name="kozure12.8d" crc="15f4021d" map="01"/>
      <part name="kozure13.9d" crc="b3b6c753" map="10"/>
    </interleave>

    <!-- text - starts at 0x140000 -->
    <part name="kozure9.11e" crc="e041356e"/>
    <part repeat="0x8000">FF</part>

    <!-- audiocpu - starts at 0x150000 -->
    <part name="kozure11.17k" crc="dba51e2d"/>

    <!-- extra - starts at 0x160000 -->
    <part repeat="0x10000">FF</part>

    <!-- mcu - starts at 0x170000 -->
    <part repeat="0x10000">FF</part>

    <!-- nb1414m4 - starts at 0x180000 -->
    <part name="kozure10.11c" crc="f48be21d"/>
    <part repeat="0xc000">FF</part>

    <!-- proms - starts at 0x190000 -->
    <part name="n82s129an.11j" crc="81244757"/>
    <part repeat="0x3f00">FF</part>

    <!-- Total 0x194000 bytes -->
  </rom>

  <!-- game select (pcb) -->
  <rom index="1">
    <part>01</part>
  </rom>

  <!-- hiscore table: address[4], length[2], start byte, end byte - MAME 0.288 plugins/hiscore/hiscore.dat -->
  <rom index="3" md5="none">
    <part>
      00 06 37 C0 00 04 00 00
      00 06 35 B4 00 28 00 00
    </part>
  </rom>
  <nvram index="4" size="44"/>
</misterromdescription>
