<misterromdescription>
  <name>ESP Ra.De. (Japan, 1998 4/14 Master Ver.)</name>
  <mameversion>0289</mameversion>
  <setname>espradejo</setname>
  <year>1998</year>
  <manufacturer>CAVE</manufacturer>
  <category>Shooter</category>
  <rotation>vertical (ccw)</rotation>
  <rbf>cave</rbf>

  <!-- ROM data -->
  <rom index="0" zip="espradejo.zip|esprade.zip" md5="none" address="0x30000000">
    <!-- prog ROM -->
    <interleave output="16">
      <part name="u42.bin" crc="0718c7e5" map="01" />
      <part name="u41.bin" crc="def30539" map="10" />
    </interleave>

    <!-- EEPROM -->
    <part name="eeprom-esprade.bin" crc="315fb546" />

    <!-- sound ROM -->
    <part name="esp_u19.u19" crc="f54b1cab" />

    <!-- layer 0 -->
    <part name="esp_u54.u54" crc="e7ca6936" />
    <part name="esp_u55.u55" crc="f53bd94f" />

    <!-- layer 1 -->
    <part name="esp_u52.u52" crc="e7abe7b4" />
    <part name="esp_u53.u53" crc="51a0f391" />

    <!-- layer 2 -->
    <part name="esp_u51.u51" crc="0b9b875c" />

    <!-- sprites -->
    <interleave output="16">
      <part name="esp_u63.u63" crc="2f2fe92c" map="01" />
      <part name="esp_u64.u64" crc="491a3da4" map="10" />
    </interleave>
    <interleave output="16">
      <part name="esp_u65.u65" crc="06563efe" map="01" />
      <part name="esp_u66.u66" crc="7bbe4cfc" map="10" />
    </interleave>

    <!-- enable C button in EEPROM -->
    <patch offset="0x00100002">ff ff</patch>
    <patch offset="0x00100008">00 04</patch>
  </rom>

  <!-- select game -->
  <rom index="1">
    <part>03</part>
  </rom>

  <!-- NVRAM -->
  <nvram index="2" size="244" />

  <!-- high-score RAM: start, length, first/last initialization bytes -->
  <rom index="4"><part>00 10 23 B0 00 50 00 8C 00 10 22 EC 00 04 00 00</part></rom>

  <buttons names="Main Shot,Power Shot,Guard Barrier,-,Start,Coin,Pause,-,-,SS" default="A,B,X,,R,L,Start" />
</misterromdescription>
