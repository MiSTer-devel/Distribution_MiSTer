<misterromdescription>
  <name>Armed F (Fillmore license)</name>
  <mameversion>0288</mameversion>
  <setname>armedff</setname>
  <year>1988</year>
  <manufacturer>Nichibutsu (Fillmore license)</manufacturer>
  <category>Shoot 'em up</category>
  <rotation>vertical (ccw)</rotation>
  <parent>armedf</parent>
  <rbf>ArmedFMD</rbf>

  <switches default="df,cf">
    <!-- DSW1 -->
    <dip name="Lives" bits="0,1" ids="3,4,5,6" values="3,2,1,0"/>
    <dip name="Bonus Life" bits="2,3" ids="20k/every 60k,20k/every 80k,40k/every 60k,40k/every 80k" values="3,1,2,0"/>
    <dip name="Demo Sounds" bits="4" ids="Off,On" values="0,1"/>
    <dip name="Cabinet" bits="5" ids="Upright,Cocktail" values="0,1"/>
    <dip name="Difficulty" bits="6,7" ids="Easy,Normal,Hard,Hardest" values="3,2,1,0"/>
    <!-- DSW2 -->
    <dip name="Coin A" bits="8,9" ids="2 Coins/1 Credit,1 Coin/1 Credit,1 Coin/2 Credits,Free Play" values="1,3,2,0"/>
    <dip name="Coin B" bits="10,11" ids="2 Coins/1 Credit,1 Coin/1 Credit,2 Coins/3 Credits,1 Coin/2 Credits" values="1,3,0,2"/>
    <dip name="Allow Continue" bits="12,13" ids="No,3 Times,5 Times,Yes" values="3,2,1,0"/>
    <dip name="Flip Screen" bits="14" ids="Off,On" values="1,0"/>
    <dip name="Unused" bits="15" ids="Off,On" values="1,0"/>
  </switches>

  <buttons names="Beam,Reverse,-,-,Start,Coin,Pause,-,-,Save/Load" default="A,B,Start,Select,R,L"/>

  <rom index="0" zip="armedff.zip|armedf.zip" md5="fd3b81a56618775707cf877887bdb32e">
    <!-- maincpu - starts at 0x0 -->
    <interleave output="16">
      <part name="af_06.rom" crc="c5326603" map="01"/>
      <part name="af_01.rom" crc="458e9542" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="af_07.rom" crc="cc8517f5" map="01"/>
      <part name="af_02.rom" crc="214ef220" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="af_08.rom" crc="d1d43600" map="01"/>
      <part name="af_03.rom" crc="bbe1fe2d" map="10"/>
    </interleave>
    <part repeat="0x20000">FF</part>

    <!-- foreground - starts at 0x80000 -->
    <part name="af_04.rom" crc="44d3af4f"/>
    <part name="af_05.rom" crc="92076cab"/>
    <part repeat="0x20000">FF</part>

    <!-- background - starts at 0xc0000 -->
    <part name="af_14.rom" crc="8c5dc5a7"/>
    <part name="af_13.rom" crc="136a58a3"/>
    <part repeat="0x20000">FF</part>

    <!-- sprite - starts at 0x100000 -->
    <interleave output="16">
      <part name="af_11.rom" crc="b46c473c" map="01"/>
      <part name="af_12.rom" crc="23cb6bfe" map="10"/>
    </interleave>

    <!-- text - starts at 0x140000 -->
    <part name="af_09.rom" crc="7025e92d"/>
    <part repeat="0x8000">FF</part>

    <!-- audiocpu - starts at 0x150000 -->
    <part name="af_10.rom" crc="c5eacb87"/>

    <!-- extra - starts at 0x160000 -->
    <part repeat="0x10000">FF</part>

    <!-- mcu - starts at 0x170000 -->
    <part repeat="0x10000">FF</part>

    <!-- nb1414m4 - starts at 0x180000 -->
    <part repeat="0x10000">FF</part>

    <!-- proms - starts at 0x190000 -->
    <part repeat="0x4000">FF</part>

    <!-- Total 0x194000 bytes -->
  </rom>

  <!-- game select (pcb) -->
  <rom index="1">
    <part>02</part>
  </rom>

  <!-- hiscore table: address[4], length[2], start byte, end byte - MAME 0.288 plugins/hiscore/hiscore.dat -->
  <rom index="3" md5="none">
    <part>
      00 06 11 B6 00 4F 00 4A
      00 06 12 06 00 04 00 00
    </part>
  </rom>
  <nvram index="4" size="83"/>
</misterromdescription>
