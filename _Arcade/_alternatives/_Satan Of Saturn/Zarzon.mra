<misterromdescription>
    <name>Zarzon</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Satan Of Saturn</series>
    <year>1981</year>
    <manufacturer>SNK (Taito America license)</manufacturer>
    <category>Shooter</category>

    <setname>zarzon</setname>
    <parent>satansat</parent>
    <mameversion>0289</mameversion>
    <rbf>SNK6502</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (cw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>2-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Fire,Button 2,-,-,Coin,Start 1P,Start 2P,Pause,-,-,-" default="A,B,Select,Start,R,L"/>

    <switches default="15">
        <dip name="Cabinet" bits="0" ids="Upright,Cocktail" values="1,0"/>
        <dip name="Coinage (SW1:2)" bits="1" ids="1C/1C,1C/2C"/>
        <dip name="Coinage 2C/1C (SW1:4)" bits="3" ids="Off,On"/>
        <dip name="Bonus Life" bits="2" ids="5000,10000" values="1,0"/>
        <dip name="Lives" bits="4,5" ids="3,4,5" values="0,1,2"/>
        <dip name="RAM Test" bits="7" ids="Off,On"/>
    </switches>

