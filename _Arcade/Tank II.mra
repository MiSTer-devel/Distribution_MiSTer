<misterromdescription>
    <name>Tank II</name>
    <setname>tankii</setname>
    <rbf>Tank</rbf>
    <mameversion>0289</mameversion>
    <about>Tank II (Kee Games / Atari, 1975). Same Board I Rev H / Board II Rev G
assemblies (A003110/A003112), harness (K5T 003492) and 90-2006 ROM as Tank
(TM-049). Board II JU1 "optional jumper for alternate playfield" is not fitted
by default - select Maze: Alternate in the OSD to fit it.</about>
    <year>1975</year>
    <manufacturer>Kee Games (Atari)</manufacturer>
    <category>Shooter / Maze</category>
    <players>2 (simultaneous)</players>
    <joystick>2 x 2-way (twin sticks per player)</joystick>
    <rotation>Horizontal</rotation>

    <!-- MAME's tankii dump is the same 2048-byte image plus one trailing 0xFF
         overdump byte (2049 bytes, CRC c25f6014); only the first 2 KB load. -->
    <rom index="0" zip="tankii.zip|tank.zip" md5="a18a083787ddf84ac6e8a0d1be67b906">
        <part name="90-2006.k10" length="2048"/>
    </rom>

    <!-- Byte 0 [1:0] = monitor orientation (HDMI framebuffer rotation) -->
    <switches default="00">
        <dip bits="0,1" name="Monitor" ids="Upright,Cocktail CW,Cocktail CCW"/>
    </switches>
</misterromdescription>
