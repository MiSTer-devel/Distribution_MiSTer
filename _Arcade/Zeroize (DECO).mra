<?xml version="1.0" encoding="UTF-8"?>
<!--
  Zeroize (US) (czeroize) — Type 3 Dongle, NO_DUMP — synthesized per MAME's own donglerom hack

  Per MAME decocass.cpp/decocass_m.cpp:
  - ROM_START(czeroize): DECOCASS_BIOS_B_ROMS (standard USA BIOS) + a "dongle" ROM_REGION that is
    ROM_LOAD("czeroize.pro", 0x0000, 0x1000, NO_DUMP) — the physical dongle chip was never read out.
    The CASSETTE itself (czeroize.cas, 64 KB) IS dumped — this is a real cassette game, only the
    separate protection dongle is missing.
  - MAME papers over the missing dump in MACHINE_RESET_MEMBER(decocass_type3_state,czeroize)
    (decocass_m.cpp:1656-1674): zero-fills the whole 4 KB dongle region, then hand-patches TWO
    bytes — m_donglerom[0x8a0]=0x18, m_donglerom[0x8a1]=0xf7 — with the driver author's own comment:
    "This hack seems to be sufficient to get around the missing dongle ROM contents and play the
    game." It's Type 3 hardware (decocass_type3_state) with m_type3_swap = TYPE3_SWAP_23_56
    (enum ordinal 8, decocass_m.cpp:48/1660).
  - No RTL changes needed: dongle_type3.v already implements swap mode 8 (TYPE3_SWAP_23_56) —
    see its header table. This game is PURELY the synthesized-PROM data embedded below, loaded
    through the same ioctl-index-1 -> SDRAM path every other dongle type already uses.
  - DIPs: czeroize has a custom INPUT_PORTS_START overriding only DSW2 Lives (bit0) and Bonus_Life
    (bits1-2) vs the base "decocass" port; MAME's own comment says "other dips not verified" — left
    at hardware default here, same as MAME.

  Region map (index 0) matches rtl/rom/rom_loader.v:
    $00000-$00FFF  Main 6502 BIOS  = v0b-.7e  (BIOS B / USA, 4 KB)
    $01000-$017FF  Audio 6502 BIOS = v1-.5a   (2 KB)
    $01800-$01BFF  MCU ROM         = cassmcu.1c (1 KB)
    $01C00-$01CFF  BIOS PROMs      (3 x 32 B + 160 B pad)
    $01D00-$02CFF  legacy 4 KB dongle PROM region (UNUSED; dongle loads via ioctl index 1; zeros)
    $02D00-$02DFF  Spare
    $02E00-$02EFF  Metadata: dongle_type=03 (Type 3), game_id=00 (unused for Type 3), swap_mode=08
    $02F00-$02FFF  Reserved
    $03000-       Cassette image (czeroize.cas, 64 KB — real dump, not affected by the dongle gap)
  index 1: the synthesized 4 KB Type-3 dongle PROM (all zero except 0x8A0=0x18, 0x8A1=0xF7).
-->
<misterromdescription>
    <name>Zeroize (US)</name>
    <setname>czeroize</setname>
    <rbf>DECOCassette</rbf>
    <mameversion>0268</mameversion>
    <year>1983</year>
    <manufacturer>Data East Corporation</manufacturer>
    <category>Shooter</category>

  	<rotation>vertical (ccw)</rotation>

    <rom index="0" zip="decocass.zip|czeroize.zip" md5="none">
        <!-- $00000-$00FFF: Main 6502 BIOS (BIOS B / USA) -->
        <part name="v0b-.7e" crc="23d929b7"/>

        <!-- $01000-$017FF: Audio 6502 BIOS -->
        <part name="v1-.5a" crc="b66b2c2a"/>

        <!-- $01800-$01BFF: MCU ROM -->
        <part name="cassmcu.1c" crc="a6df18fd"/>

        <!-- $01C00-$01CFF: BIOS PROMs (96 B + 160 B pad) -->
        <part name="v2.3m"  crc="238fdb40"/>
        <part name="v4.10d" crc="3b5836b4"/>
        <part name="v3.3j"  crc="51eef657"/>
        <part repeat="0xA0">00</part>

        <!-- $01D00-$02CFF: legacy 4 KB dongle PROM region (unused; dongle moved to ioctl index 1; zeros) -->
        <part repeat="0x1000">00</part>

        <!-- $02D00-$02DFF: Spare -->
        <part repeat="0x100">00</part>

        <!-- $02E00-$02EFF: Metadata (Type 3, game_id=00 unused, swap_mode=08 = TYPE3_SWAP_23_56) -->
        <part>03 00 08</part>
        <part repeat="0xFD">00</part>

        <!-- $02F00-$02FFF: Reserved -->
        <part repeat="0x100">00</part>

        <!-- $03000-: Cassette image -->
        <part name="czeroize.cas" crc="3ef0a406"/>
    </rom>

    <!-- SYNTHESIZED Type-3 dongle PROM — the real chip was NEVER DUMPED (NO_DUMP in MAME). This is
         MAME's own donglerom hack (decocass_m.cpp:1662-1673) reproduced byte-for-byte: 4 KB of zero
         except offset 0x8A0=0x18, 0x8A1=0xF7. Not a real dump — a reverse-engineered patch the MAME
         author found "sufficient to get around the missing dongle ROM contents and play the game."
         Loads via the same generic ioctl-index-1 -> SDRAM path every other dongle type uses. -->
    <rom index="1" zip="decocass.zip|czeroize.zip" md5="none">
        <part repeat="0x8A0">00</part>
        <part>18 F7</part>
        <part repeat="0x75E">00</part>
    </rom>

    <!-- DSW2 bits 16 (Lives) / 17-18 (Bonus Life) are czeroize-specific overrides (decocass.cpp:829-841,
         PORT_MODIFY over the base "decocass" port); MAME comment: "other dips not verified", so DSW2
         bits 19-20 and all of DSW1 are left at the standard decocass base (Country Code/Coin A/Coin B/
         Type of Tape/Cabinet), same block used across the fleet. -->
    <switches default="00,00,FF,3F">
        <dip bits="16"    name="Lives"      ids="5,3"/>
        <dip bits="17,18" name="Bonus Life" ids="None,50000,70000,90000"/>
        <dip bits="21,23" name="Country Code" ids="inv,inv,F,E,D,C,B,A"/>
        <dip bits="24,25" name="Coin A" ids="2C/1C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="26,27" name="Coin B" ids="2C/1C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="28,29" name="Type of Tape" ids="MT Big,inv,inv,MD Small"/>
        <dip bits="30" name="Cabinet" ids="Upright,Cocktail"/>
    </switches>

    <buttons names="Button1,Button2,Coin,Start 1P,Start 2P,Pause" default="A,B,Select,Start,R,L"/>
</misterromdescription>
