<misterromdescription>
  <name>Kokontouzai Eto Monogatari (Japan)</name>
  <setname>eto</setname>
  <mameversion>0264</mameversion>
  <rbf>TaitoAsuka</rbf>
  <year>1994</year>
  <manufacturer>Visco</manufacturer>
  <category>Puzzle</category>
  <rotation>horizontal</rotation>
  <resolution>15kHz</resolution>
  <players>2</players>
  <joystick>8-way</joystick>
  <num_buttons>2</num_buttons>
  <buttons default="A,B,Start" names="Button 1,Button 2,-,-,-,-,Start,Coin,Pause"/>

  <!-- DSWA come tutti gli altri set del driver; del DSWB il gioco legge solo la
       difficolta', il resto MAME lo marca inutilizzato. Default FF,FF. -->
  <switches base="0" default="FF,FF">
    <dip name="Unused"         bits="0"     ids="On,Off"/>
    <dip name="Flip Screen"    bits="1"     ids="On,Off"/>
    <dip name="Service Mode"   bits="2"     ids="On,Off"/>
    <dip name="Demo Sounds"    bits="3"     ids="Off,On"/>
    <dip name="Coin A"         bits="4,5"   ids="2 Coins/3 Credits,2 Coins/1 Credit,1 Coin/2 Credits,1 Coin/1 Credit"/>
    <dip name="Coin B"         bits="6,7"   ids="2 Coins/3 Credits,2 Coins/1 Credit,1 Coin/2 Credits,1 Coin/1 Credit"/>
    <dip name="Difficulty"     bits="8,9"   ids="Hardest,Hard,Easy,Medium"/>
  </switches>

  <!-- Regione di configurazione, caricata PRIMA delle ROM.
       byte 0 = game_id      : 0x04 = Eto Monogatari
       byte 1 = link         : 0x01 accende il multiplayer (solo Cadash)
       byte 2 = orientamento : 0x00 = set orizzontale (ROT0)
       byte 3 = libero -->
  <rom index="1">
    <part>04 00 00 00</part>
  </rom>

  <!-- Terza mappa di memoria del driver (base_state::eto_map): stessi chip di
       Asuka, indirizzi tutti diversi. Palette a 100000, RAM a 200000, IOC a
       300000 col mirror in lettura a 400000, sprite a C00000, tile a D00000.
       La mappa delle ROM invece e' la stessa: cambia solo cosa c'e' dentro.
       Niente estensione sprite e niente ADPCM: la scheda non li monta. -->

  <rom index="0" zip="eto.zip" md5="None">

    <!-- 0x000000 Main CPU 68000, 256 KB. Le due meta' entrano coi byte
         SCAMBIATI rispetto a MAME: il core impacchetta la parola SDRAM come
         {secondo byte, primo byte}, quindi la ROM dei byte PARI di MAME va
         messa con map="10" e quella dei DISPARI con map="01". -->
    <interleave output="16">
      <part name="eto-1.ic23" crc="44286597" map="10"/>
      <part name="eto-0.ic8"  crc="57b79370" map="01"/>
    </interleave>
    <part repeat="0x40000"> FF</part>

    <!-- 0x080000 Fix ROM, 512 KB. La legge il 68000 a parole, quindi stesso
         ordine di byte del programma: interleave con map="12". -->
    <interleave output="16">
      <part name="eto-2.ic30" crc="12f46fb5" map="12"/>
    </interleave>
    <part repeat="0x20000"> FF</part>

    <!-- 0x120000 Z80 audio, 64 KB, byte lineari come in MAME. -->
    <part name="eto-5.ic27" crc="b3689da0"/>
    <part repeat="0x10000"> FF</part>

    <!-- 0x140000 Sprite PC090OJ, 512 KB (ROM_LOAD16_WORD_SWAP -> map="12").
         In MAME il commento su eto-3 dice "SCR tiles", ma la regione in cui la
         carica e' pc090oj: vale la regione, non il commento. -->
    <interleave output="16">
      <part name="eto-3.ic6" crc="dd247397" map="12"/>
    </interleave>

    <!-- 0x1C0000 Nessuna estensione sprite su questo set: 128 KB di FF. -->
    <part repeat="0x20000"> FF</part>
    <part repeat="0x160000"> FF</part>

    <!-- 0x340000 Tile TC0100SCN, 512 KB (ROM_LOAD16_WORD_SWAP -> map="12"). -->
    <interleave output="16">
      <part name="eto-4.ic3" crc="a8768939" map="12"/>
    </interleave>
    <part repeat="0x80000"> FF</part>

    <!-- 0x440000 ADPCM MSM5205, 64 KB. -->
    <!-- Zoccolo vuoto su questo set: 64 KB di FF, come ROMREGION_ERASEFF. -->
    <part repeat="0x10000"> FF</part>

  </rom>
</misterromdescription>
