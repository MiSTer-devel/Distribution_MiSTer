<misterromdescription>
    <name>Nibbler (Rev 8, Olympia)</name>
    <setname>nibblero</setname>
    <parent>nibbler</parent>
    <rbf>SNK6502</rbf>
    <mameversion>0289</mameversion>
    <year>1983</year>
    <manufacturer>Rock-Ola (Olympia license)</manufacturer>
    <players>1</players>
    <joystick>4-way</joystick>
    <rotation>vertical (cw)</rotation>
    <region>World</region>
    <category>Maze</category>

    <switches default="00" base="16">
        <dip name="Lives" bits="0,1" ids="2,3,4,5"/>
        <dip name="Difficulty" bits="2" ids="Easy,Hard"/>
        <dip name="Cabinet" bits="3" ids="Upright,Cocktail"/>
        <dip name="Service Mode" bits="4" ids="Off,On"/>
        <dip name="Free Play" bits="5" ids="Off,On"/>
        <dip name="Coinage" bits="6,7" ids="1C/1C,2C/1C,2C/1C 4C/3,1C/1C 2C/3"/>
    </switches>

    <buttons names="-,-,-,-,Coin,Start 1P,Start 2P,Pause" default="Select,Start,R,L"/>

    <rom index="0" zip="nibblero.zip|nibbler.zip" md5="none">
