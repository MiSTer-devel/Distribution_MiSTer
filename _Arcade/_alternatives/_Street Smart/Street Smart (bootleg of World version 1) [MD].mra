            <part name="25r.25" crc="9fe6e970" map="0100"/>
            <part name="16r.16" crc="466b39b7" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="6l.6" crc="56ebc520" map="0001"/>
            <part name="4l.4" crc="54dc8dae" map="0010"/>
            <part name="14r.14" crc="e9697bd1" map="0100"/>
            <part name="12r.12" crc="8307f243" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="5l.5" crc="9943ce65" map="0001"/>
            <part name="3l.3" crc="596e388e" map="0010"/>
            <part name="13r.13" crc="3255af03" map="0100"/>
            <part name="11r.11" crc="5bad15c1" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="16l.16" crc="7599dbb5" map="0001"/>
            <part name="24r.24" crc="58099ef5" map="0010"/>
            <part name="8r.8" crc="9c52f1ea" map="0100"/>
            <part name="9r.9" crc="380dcee5" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="7l.7" crc="b36db591" map="0001"/>
            <part name="15r.15" crc="2e9b47c5" map="0010"/>
            <part name="7r.7" crc="0c474722" map="0100"/>
            <part name="10r.10" crc="9d617689" map="1000"/>
        </interleave>
        <!-- Total 0x400000 bytes - 4096 kBytes -->
    </rom>

    <!-- hiscore: address[4] length[2] start end, MAME 0.288 plugins/hiscore/hiscore.dat -->
    <rom index="3" md5="none">
        <part>
            00 04 14 70 00 A0 20 20
            00 04 3F 7E 00 04 00 00
        </part>
    </rom>
    <nvram index="4" size="164"/>
