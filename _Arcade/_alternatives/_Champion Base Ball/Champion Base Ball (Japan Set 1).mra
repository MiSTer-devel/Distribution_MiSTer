<misterromdescription>
    <name>Champion Base Ball (Japan Set 1)</name>
    <region>Japan</region>
    <homebrew>no</homebrew>
    <bootleg>no</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Champion Base Ball</series>
