<misterromdescription>
	<name>99 The Last War (Set 2)</name>
	<region>World</region>
	<year>1985</year>
	<manufacturer>Crux / Proma</manufacturer>
	<category>Shooter</category>

	<setname>99lstwara</setname>
	<parent>repulse</parent>
	<rbf>Kyugo</rbf>
	<mameversion>0289</mameversion>

	<resolution>15kHz</resolution>
	<rotation>vertical (cw)</rotation>
	<flip>no</flip>

	<players>2 (alternating)</players>
	<joystick>8-way</joystick>
	<num_buttons>2</num_buttons>
	<button_names>Fire,Bomb</button_names>

	<switches default="BF,BF">
		<!-- DSW1 (AY1 port A, read & inverted by sub) -->
		<dip bits="0,1"      name="Lives"           ids="6,5,4,3"/>
		<dip bits="2"        name="Bonus Life"      ids="Every 70000,Every 50000"/>
		<dip bits="3"        name="Slow Motion"     ids="On,Off"/>
		<dip bits="4"        name="Invulnerability" ids="On,Off"/>
		<dip bits="5"        name="Sound Test"      ids="On,Off"/>
		<dip bits="6"        name="Cabinet"         ids="Upright,Cocktail"/>
		<dip bits="7"        name="Freeze"          ids="On,Off"/>
		<!-- DSW2 (AY1 port B) -->
		<dip bits="8,10"     name="Coin A"          ids="Free Play,3C/2C,2C/1C,1C/6C,1C/4C,1C/3C,1C/2C,1C/1C"/>
		<dip bits="11,13"    name="Coin B"          ids="5C/1C,4C/1C,3C/1C,2C/1C,3C/4C,1C/3C,1C/2C,1C/1C"/>
		<dip bits="14,15"    name="Difficulty"      ids="Hardest,Hard,Normal,Easy"/>
	</switches>

	<!-- Index 1: variant | rot_flip (bit 3) | landscape (bit 4). MAME machine config "repulse" = the parent's. -->
	<rom index="1">
		<part>09</part>
	</rom>

	<!-- Index 0: main 32K, sub 32K, FG 4K, BG planes 3x 16K (8K + pad, in MAME's "plane N" order), sprite planes
	     3x 32K, PROMs R / G / B, char lookup, timing (rtl/ram_rom/rom_loader.sv) -->
	<rom index="0" md5="none" zip="99lstwara.zip|repulse.zip">
		<part crc="efe2908d" name="4f.bin"/>
		<part crc="5b79c342" name="4h.bin"/>
		<part crc="d2a62c1b" name="4j.bin"/>
		<part repeat="0x2000"> 00 </part>
		<part crc="cb9d8291" name="2f.bin"/>
		<part crc="24dbddc3" name="2h.bin"/>
		<part crc="16879c4c" name="2j.bin"/>
		<part crc="86b267f3" name="repulse.b4"/>
		<part crc="49a2383e" name="1999.4a"/>
		<part crc="59993c27" name="9h.bin"/>
		<part repeat="0x2000"> 00 </part>
		<part crc="dfbf0280" name="10h.bin"/>
		<part repeat="0x2000"> 00 </part>
		<part crc="e4f29fc0" name="11h.bin"/>
		<part repeat="0x2000"> 00 </part>
		<part crc="98d44410" name="6a.bin"/>
		<part crc="4c54d281" name="7a.bin"/>
		<part crc="81018101" name="8a.bin"/>
		<part crc="347b91fd" name="9a.bin"/>
		<part crc="f07de4fa" name="10a.bin"/>
		<part crc="34a04f48" name="11a.bin"/>
		<part crc="3ea35431" name="b.1j"/>
		<part crc="acd7a69e" name="g.1h"/>
		<part crc="b7f48b41" name="r.1f"/>
		<part crc="cce2e29f" name="n82s123n.5j"/>
		<part crc="83a39201" name="m1.2c"/>
	</rom>

	<nvram index="4" size="2048"></nvram>
	<remark>'99: The Last War (Crux / Proma)</remark>
</misterromdescription>
