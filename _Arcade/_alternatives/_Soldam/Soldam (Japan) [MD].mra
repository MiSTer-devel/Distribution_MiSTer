<misterromdescription>
    <name>Soldam (Japan)</name>
    <setname>soldamj</setname>
    <rbf>MegaSys1_AMD</rbf>
    <mameversion>0288</mameversion>
    <year>1992</year>
    <manufacturer>Jaleco</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>

    <!-- DIP switches: MAME 0.288 -listxml -->
    <switches default="FF,FF">
        <dip name="Coin A" bits="0,2" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/1Cr,1C/2Cr,1C/3Cr,1C/4Cr,Free Play" values="1,2,3,7,6,5,4,0"/>
        <dip name="Coin B" bits="3,5" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/1Cr,1C/2Cr,1C/3Cr,1C/4Cr,Free Play" values="1,2,3,7,6,5,4,0"/>
        <dip name="Demo Sounds" bits="6" ids="Off,On" values="0,1"/>
        <dip name="Service Mode" bits="7" ids="Off,On" values="1,0"/>
        <dip name="Difficulty" bits="8,9" ids="Easy,Normal,Hard,Hardest" values="0,3,2,1"/>
        <dip name="Games To Play (Vs)" bits="10,11" ids="1,2,3,4" values="0,3,2,1"/>
        <dip name="Allow Continue" bits="12" ids="Off,On" values="0,1"/>
        <dip name="Credits To Start (Vs)" bits="13" ids="1,2" values="1,0"/>
        <dip name="Credits To Continue (Vs)" bits="14" ids="1,2" values="1,0"/>
        <dip name="Flip Screen" bits="15" ids="Off,On" values="1,0"/>
    </switches>

    <!-- button names: va7deo MRAs -->
    <buttons names="Rotate Left,Rotate Right,-,Start,Coin,Pause,Save/Load" default="A,B,Start,Select,R,L"/>

    <rom index="1">
        <part>08</part>
    </rom>

    <rom index="2">
        <part>
            00 00 14 32   00 00 43 12   00 01 43 02   00 00 12 43
            00 01 04 32   00 04 31 02   00 04 30 12   00 02 10 43
            00 02 01 43   00 00 24 31   00 00 43 21   00 00 21 43
            00 01 02 43   00 01 20 43   00 04 32 01   00 02 43 01
        </part>
    </rom>

    <rom index="3">
        <part>10</part>
    </rom>

    <rom index="0" zip="soldamj.zip|soldam.zip" md5="none">
        <!-- maincpu - starts at 0x0 -->
        <interleave output="16">
            <part name="soldam2.bin" crc="c73d29e4" map="01"/>
            <part name="soldam1.bin" crc="e7cb0c20" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="3ver1.bin" crc="c5382a07" map="01"/>
            <part name="4ver1.bin" crc="1df7816f" map="10"/>
        </interleave>
        <part repeat="0x20000">FF</part>

        <!-- audiocpu - starts at 0x80000 -->
        <interleave output="16">
            <part name="5ver1.bin" crc="d1019a67" map="01"/>
            <part name="6ver1.bin" crc="3ed219b4" map="10"/>
        </interleave>
        <part repeat="0x60000">FF</part>

        <!-- oki1 - starts at 0x100000 -->
        <part name="10ver1.bin" crc="8d5613bf"/>
        <part repeat="0xc0000">FF</part>

        <!-- oki2 - starts at 0x200000 -->
        <part name="8ver1.bin" crc="fcd36019"/>
        <part repeat="0x40000">FF</part>

        <!-- scroll1 - starts at 0x280000 -->
        <part name="soldam14.bin" crc="26cea54a"/>

        <!-- scroll2 - starts at 0x300000 -->
        <part name="soldam18.bin" crc="7d8e4712"/>

        <!-- scroll3 - starts at 0x380000 -->
        <part name="19ver1.bin" crc="38465da1"/>
        <part repeat="0x60000">FF</part>

        <!-- sprites - starts at 0x400000 -->
        <part name="23ver1.bin" crc="0ca09432"/>
        <part repeat="0x80000">FF</part>

        <!-- proms - starts at 0x500000 -->
        <part name="pr-91023.14m" crc="8914e72d"/>

    </rom>

    <!-- hiscore table: address[4], length[2], start byte, end byte - MAME 0.288 plugins/hiscore/hiscore.dat -->
    <rom index="4" md5="none">
        <part>
            00 0F 00 BA 00 08 00 00
            00 0F 3F BE 02 4A 00 81
        </part>
    </rom>
    <nvram index="5" size="594"/>
</misterromdescription>
