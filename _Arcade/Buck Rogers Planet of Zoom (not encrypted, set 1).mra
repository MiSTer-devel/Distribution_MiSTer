		<dip bits="3,4,5" name="Coin B" ids="1C_1C,1C_2C,1C_3C,1C_6C,2C_1C,3C_1C,4C_1C,5C_1C"/>
		<dip bits="8" name="Collisions" ids="On,Off (Cheat)"/>
		<dip bits="9" name="Accel By" ids="Pedal,Button"/>
		<dip bits="10" name="Best 5 Scores" ids="On,Off"/>
		<dip bits="11" name="Score Display" ids="Off,On"/>
		<dip bits="12" name="Difficulty" ids="Hard,Normal"/>
		<dip bits="13,14" name="Lives" ids="3,4,5,6"/>
		<dip bits="15" name="Cabinet" ids="Cockpit,Upright"/>
	</switches>
	<rom index="1"><part>00</part></rom>
