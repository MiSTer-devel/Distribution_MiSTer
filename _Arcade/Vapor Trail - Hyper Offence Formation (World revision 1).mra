<misterromdescription>
    <about author="jotego" webpage="https://patreon.com/jotego" twitter="@topapate" source="https://jotego/jtcores"/>
    <rotation>vertical (ccw)</rotation>
    <name>Vapor Trail - Hyper Offence Formation (World revision 1)</name>
    <setname>vaportra</setname>
    <mameversion>0282</mameversion>
    <year>1989</year>
    <manufacturer>Data East Corporation</manufacturer>
    <players>2</players>
    <rbf>deco16</rbf>
    <joystick>8</joystick>
    <region>World</region>
    <rom index="0" zip="vaportra.zip" md5="None">
        <!-- 
  0[0]: cninja     Caveman Ninja hardware
  0[1]: cbust      Crude Buster hardware
  0[2]: dseal      Dark Seal hardware
  0[3]: vapor      Vapor Trail hardware
  0[4]: edrndy     Edward Randy hardware -->
        <part>
            08 00 00 00 00 00 00 00
            00 00 00 00 00 00 00 00
        </part>
        <!-- sprites1 - starts at 0x0 - length 0x100000 (20 bits) -->
        <interleave output="32">
            <part name="vtmaa03.bin" crc="1a30bf81" map="0021" length="0x80000"/>
            <part name="vtmaa04.bin" crc="b713e9cc" map="2100" length="0x80000"/>
        </interleave>
        <!-- SPR2_START -->
        <!-- sprites1hi - starts at 0x100000 - length 0x400000 (22 bits) -->
        <part repeat="0x400000"> FF</part>
        <!-- SND_START -->
        <!-- audiocpu - starts at 0x500000 - length 0x10000 (16 bits) -->
        <part name="fj04" crc="e9aedf9b"/>
        <!-- GFX3_START -->
        <!-- JTFRAME_BA1_START -->
        <!-- tiles2 - starts at 0x510000 - length 0x100000 (20 bits) -->
        <interleave output="32">
            <part name="vtmaa02.bin" crc="091ff98e" map="0021" length="0x80000"/>
            <part name="vtmaa01.bin" crc="c217a31b" map="2100" length="0x80000"/>
        </interleave>
        <!-- JTFRAME_BA2_START -->
        <!-- maincpu - starts at 0x610000 - length 0x100000 (20 bits) -->
        <interleave output="16">
            <part name="fl_00-1.bin" crc="c08cc048" map="01"/>
            <part name="fl_02-1.bin" crc="9ae36095" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="fl_01.bin" crc="9474b085" map="01"/>
            <part name="fl_03.bin" crc="80bd2844" map="10"/>
        </interleave>
        <part repeat="0x80000"> FF</part>
        <!-- PCM_START -->
        <!-- oki1 - starts at 0x710000 - length 0x40000 (18 bits) -->
        <part name="fj06" crc="6e98a235"/>
        <part repeat="0x20000"> FF</part>
        <!-- PCM2_START -->
        <!-- oki2 - starts at 0x750000 - length 0x80000 (19 bits) -->
        <part name="fj05" crc="39cda2b5"/>
        <part repeat="0x60000"> FF</part>
        <!-- JTFRAME_BA3_START -->
        <!-- GFX1_START -->
        <!-- chars - starts at 0x7D0000 - length 0x20000 (17 bits) -->
        <interleave output="32">
            <part name="vtmaa00.bin" crc="0330e13b" map="0021" length="0x10000"/>
            <part name="vtmaa00.bin" crc="0330e13b" map="2100" length="0x10000" offset="0x40000"/>
        </interleave>
        <!-- GFX2_START -->
        <!-- tiles1 - starts at 0x7F0000 - length 0x80000 (19 bits) -->
        <part name="vtmaa00.bin" crc="0330e13b"/>
        <!-- Total 0x870000 bytes - 8640 kBytes -->
    </rom>
    <!-- Vertical screen. Orientation reversed. -->
    <rom index="1">
        <part>05 80</part>
    </rom>
    <switches page_id="1" page_name="Switches" base="16" default="7f,ff">
        <DSW/>
        <dip name="Lives" bits="0,1" ids="2,5,4,3"/>
        <dip name="Difficulty" bits="2,3" ids="Hardest,Hard,Easy,Normal"/>
        <dip name="Bonus Life" bits="4,5" ids="None,300k only,150 300 and 600,200k and 600k"/>
        <dip name="Allow Continue" bits="6" ids="No,Yes"/>
        <dip name="Demo Sounds" bits="7" ids="On,Off"/>
        <dip name="Coin A" bits="8,10" ids="3/1,2/1,1/6,1/5,1/4,1/3,1/2,1/1"/>
        <dip name="Coin B" bits="11,13" ids="3/1,2/1,1/6,1/5,1/4,1/3,1/2,1/1"/>
        <dip name="Flip Screen" bits="14" ids="On,Off"/>
        <dip name="Service Mode" bits="15" ids="On,Off"/>
    </switches>
    <buttons names="button 1,button 2,-,Start,Coin,Core credits" default="A,B,Start,Select,-" count="2"/>
</misterromdescription>
