<misterromdescription>
  <name>Galmedes (Japan)</name>
  <setname>galmedes</setname>
  <mameversion>0264</mameversion>
  <rbf>TaitoAsuka</rbf>
  <year>1992</year>
  <manufacturer>Visco</manufacturer>
  <category>Action</category>
  <rotation>vertical</rotation>
  <resolution>15kHz</resolution>
  <players>2</players>
  <joystick>8-way</joystick>
  <num_buttons>2</num_buttons>
  <buttons default="A,B,Start" names="Shot,Bomb,-,-,-,-,Start,Coin,Pause"/>

  <switches base="0" default="F7,FB">
    <dip name="Unused"         bits="0"     ids="On,Off"/>
    <dip name="Flip Screen"    bits="1"     ids="On,Off"/>
    <dip name="Service Mode"   bits="2"     ids="On,Off"/>
    <dip name="Demo Sounds"    bits="3"     ids="On,Off"/>
    <!-- Coin A e Coin B cambiano significato col Coin Mode (bit 15): qui sono
         elencate come le legge il Mode A (Japan), che e' il default. -->
    <dip name="Coin A"         bits="4,5"   ids="2 Coins/3 Credits,2 Coins/1 Credit,1 Coin/2 Credits,1 Coin/1 Credit"/>
    <dip name="Coin B"         bits="6,7"   ids="1 Coin/6 Credits,1 Coin/4 Credits,1 Coin/3 Credits,1 Coin/2 Credits"/>
    <dip name="Difficulty"     bits="8,9"   ids="Hardest,Hard,Easy,Medium"/>
    <dip name="Bonus Life"     bits="10,11" ids="Every 200k,150k And Every 200k,Every 100k,100k And Every 200k"/>
    <dip name="Lives"          bits="12,13" ids="4,2,1,3"/>
    <dip name="Unused"         bits="14"    ids="On,Off"/>
    <dip name="Coin Mode"      bits="15"    ids="Mode B (World),Mode A (Japan)"/>
  </switches>

  <!-- Regione di configurazione, caricata PRIMA delle ROM.
       byte 0 = game_id      : 0x03 = galmedes
       byte 1 = link         : 0x01 accende il multiplayer (solo Cadash)
       byte 2 = orientamento : 0x01 = set verticale (ROT270)
       byte 3 = libero -->
  <rom index="1">
    <part>03 00 01 00</part>
  </rom>

  <!-- Niente estensione sprite e niente ADPCM: sulla scheda lo zoccolo
         della MSM5205 e' vuoto (MAME: ROMREGION_ERASEFF). Le due regioni
         restano riempite di FF perche' la mappa non si sposti. -->

  <rom index="0" zip="galmedes.zip" md5="None">

    <!-- 0x000000 Main CPU 68000, 256 KB. Le due meta' entrano coi byte
         SCAMBIATI rispetto a MAME: il core impacchetta la parola SDRAM come
         {secondo byte, primo byte}, quindi la ROM dei byte PARI di MAME va
         messa con map="10" e quella dei DISPARI con map="01". -->
    <interleave output="16">
      <part name="gm-prg1.ic23" crc="32a70753" map="10"/>
      <part name="gm-prg0.ic8" crc="fae546a4" map="01"/>
    </interleave>
    <part repeat="0x40000"> FF</part>

    <!-- 0x080000 Fix ROM, 512 KB. La legge il 68000 a parole, quindi stesso
         ordine di byte del programma: interleave con map="12". -->
    <interleave output="16">
      <part name="gm-30.ic30" crc="4da2a407" map="12"/>
    </interleave>
    <part repeat="0x20000"> FF</part>

    <!-- 0x120000 Z80 audio, 64 KB, byte lineari come in MAME. -->
    <part name="gm-snd.ic27" crc="d6f56c21"/>
    <part repeat="0x10000"> FF</part>

    <!-- 0x140000 Sprite PC090OJ, 512 KB (ROM_LOAD16_WORD_SWAP -> map="12"). -->
    <interleave output="16">
      <part name="gm-obj.ic6" crc="7a4a1315" map="12"/>
    </interleave>

    <!-- 0x1C0000 Nessuna estensione sprite su questo set: 128 KB di FF. -->
    <part repeat="0x20000"> FF</part>

    <part repeat="0x160000"> FF</part>

    <!-- 0x340000 Tile TC0100SCN, 512 KB (ROM_LOAD16_WORD_SWAP -> map="12"). -->
    <interleave output="16">
      <part name="gm-scn.ic3" crc="3bab0581" map="12"/>
    </interleave>
    <part repeat="0x80000"> FF</part>

    <!-- 0x440000 ADPCM MSM5205, 64 KB, byte lineari. -->
    <!-- Zoccolo vuoto su questo set: 64 KB di FF, come ROMREGION_ERASEFF. -->
    <part repeat="0x10000"> FF</part>

  </rom>
</misterromdescription>
