<misterromdescription>
  <name>Terra Force</name>
  <mameversion>0288</mameversion>
  <setname>terraf</setname>
  <year>1987</year>
  <manufacturer>Nichibutsu</manufacturer>
  <category>Shoot 'em up</category>
  <rotation>horizontal</rotation>
  <rbf>ArmedFMD</rbf>

  <switches default="cf,3f">
    <!-- DSW1 -->
    <dip name="Lives" bits="0,1" ids="3,4,5,6" values="3,2,1,0"/>
    <dip name="Bonus Life" bits="2,3" ids="20k/every 60k,20k/every 90k,50k/every 60k,50k/every 90k" values="3,1,2,0"/>
    <dip name="Demo Sounds" bits="4" ids="Off,On" values="1,0"/>
    <dip name="Cabinet" bits="5" ids="Upright,Cocktail" values="0,1"/>
    <dip name="Difficulty" bits="6,7" ids="Easy,Normal,Hard,Hardest" values="3,2,1,0"/>
    <!-- DSW2 -->
    <dip name="Coin A" bits="8,9" ids="2 Coins/1 Credit,1 Coin/1 Credit,1 Coin/2 Credits,Free Play" values="1,3,2,0"/>
    <dip name="Coin B" bits="10,11" ids="2 Coins/1 Credit,1 Coin/1 Credit,2 Coins/3 Credits,1 Coin/2 Credits" values="1,3,0,2"/>
    <dip name="Unused" bits="12" ids="Off,On" values="1,0"/>
    <dip name="Flip Screen" bits="13" ids="Off,On" values="1,0"/>
    <dip name="Allow Continue" bits="14,15" ids="No,Only 3 Times,Only 5 Times,Yes" values="3,2,1,0"/>
  </switches>

  <buttons names="Beam Cannon,Hyper Missile,-,-,Start,Coin,Pause,-,-,Save/Load" default="A,B,Start,Select,R,L"/>

  <rom index="0" zip="terraf.zip" md5="ad4cf7b27b88a33eea6f1d862aa58605">
    <!-- maincpu - starts at 0x0 -->
    <interleave output="16">
      <part name="8.6e" crc="fd58fa06" map="01"/>
      <part name="3.6h" crc="54823a7d" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="7.4e" crc="fde8de7e" map="01"/>
      <part name="2.4h" crc="db987414" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="6.3e" crc="a5bb8c3b" map="01"/>
      <part name="1.3h" crc="d2de6d28" map="10"/>
    </interleave>
    <part repeat="0x20000">FF</part>

    <!-- foreground - starts at 0x80000 -->
    <part name="5.15h" crc="25d23dfd"/>
    <part name="4.13h" crc="b9b0fe27"/>
    <part repeat="0x20000">FF</part>

    <!-- background - starts at 0xc0000 -->
    <part name="15.8a" crc="2144d8e0"/>
    <part name="14.6a" crc="744f5c9e"/>
    <part repeat="0x20000">FF</part>

    <!-- sprite - starts at 0x100000 -->
    <interleave output="16">
      <part name="12.7d" crc="2d1f2ceb" map="01"/>
      <part name="13.9d" crc="1d2f92d6" map="10"/>
    </interleave>
    <part repeat="0x20000">FF</part>

    <!-- text - starts at 0x140000 -->
    <part name="9.11e" crc="bc6f7cbc"/>
    <part repeat="0x8000">FF</part>

    <!-- audiocpu - starts at 0x150000 -->
    <part name="11.17k" crc="4407d475"/>

    <!-- extra - starts at 0x160000 -->
    <part repeat="0x10000">FF</part>

    <!-- mcu - starts at 0x170000 -->
    <part repeat="0x10000">FF</part>

    <!-- nb1414m4 - starts at 0x180000 -->
    <part name="10.11c" crc="ac705812"/>
    <part repeat="0xc000">FF</part>

    <!-- proms - starts at 0x190000 -->
    <part name="n82s129an.11j" crc="81244757"/>
    <part repeat="0x3f00">FF</part>

    <!-- Total 0x194000 bytes -->
  </rom>

  <!-- game select (pcb) -->
  <rom index="1">
    <part>00</part>
  </rom>

  <!-- hiscore table: address[4], length[2], start byte, end byte - MAME 0.288 plugins/hiscore/hiscore.dat -->
  <rom index="3" md5="none">
    <part>
      00 06 06 6E 00 3C 00 4A
      00 06 06 B2 00 04 00 00
    </part>
  </rom>
  <nvram index="4" size="64"/>
</misterromdescription>
