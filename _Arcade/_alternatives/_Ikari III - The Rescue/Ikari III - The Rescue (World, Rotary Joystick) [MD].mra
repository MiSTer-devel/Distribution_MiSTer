<misterromdescription>
    <name>Ikari III - The Rescue (World, Rotary Joystick)</name>
    <setname>ikari3w</setname>
    <parent>ikari3</parent>
    <rbf>SNK68MD</rbf>
    <mameversion>0288</mameversion>
    <year>1989</year>
    <manufacturer>SNK</manufacturer>
    <players>2</players>
    <joystick>Rotary</joystick>
    <rotation>horizontal</rotation>
    <region>World</region>

    <switches default="ff,7f">
        <!-- DSW1 -->
        <dip name="Lives" bits="0,1" ids="2,3,4,5" values="1,3,2,0"/>
        <dip name="Coinage" bits="2,3" ids="A 4/1 B 1/4,A 3/1 B 1/3,A 2/1 B 1/2,1 Coin/1 Credit" values="0,2,1,3"/>
        <dip name="Unknown" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Bonus Occur" bits="5" ids="1st+2nd only,1st+every 2nd" values="1,0"/>
        <dip name="Blood" bits="6" ids="Off,On" values="0,1"/>
        <dip name="Flip Screen" bits="7" ids="Off,On" values="1,0"/>
        <!-- DSW2 -->
        <dip name="Service Mode" bits="8" ids="Off,On" values="1,0"/>
        <dip name="Allow Continue" bits="9" ids="No,Yes" values="0,1"/>
        <dip name="Bonus Life" bits="10,11" ids="20k 50k,40k 100k,60k 150k,None" values="3,1,2,0"/>
        <dip name="Game Mode" bits="12,13" ids="Demo Sounds Off,Demo Sounds On,Freeze,Inf Lives (Cheat)" values="1,3,0,2"/>
        <dip name="Difficulty" bits="14,15" ids="Easy,Normal,Hard,Hardest" values="3,1,2,0"/>
    </switches>

    <buttons names="Kick,Jump,Punch,Rotate CW,Rotate CCW,Start,Coin,Pause,Save States" default="A,B,X,Y,,Start,Select,R,L"/>

    <rom index="1">
        <part>00</part>
    </rom>

    <rom index="0" zip="ikari3w.zip|ikari3.zip" md5="None">
        <!-- maincpu - starts at 0x0 -->
        <interleave output="16">
            <part name="ik_2.c10" crc="d0b690d3" map="01"/>
            <part name="ik_3.c9" crc="11a9e664" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="ik3-1.c8" crc="47e4d256" map="01"/>
            <part name="ik3-4.c12" crc="a43af6b5" map="10"/>
        </interleave>
        <part repeat="0x20000"> FF</part>
        <!-- soundcpu - starts at 0x80000 -->
        <part name="ik3-5.16d" crc="ce6706fc"/>
        <part repeat="0x10000"> FF</part>
        <!-- upd - starts at 0xA0000 -->
        <part name="ik3-6.18e" crc="59d256a4"/>
        <!-- gfx1 - starts at 0xC0000 -->
        <interleave output="16">
            <part name="ik3-7.16l" crc="0b4804df" map="01"/>
            <part name="ik3-8.16m" crc="10ab4e50" map="10"/>
        </interleave>
        <part repeat="0x30000"> FF</part>
        <!-- gfx2 - starts at 0x100000 -->
        <interleave output="32">
            <part name="ikari-880d_t53.d2" crc="5855d95e" map="0001"/>
            <part name="ikari-880c_t54.c2" crc="6d728362" map="0010"/>
            <part name="ikari-880b_t51.b2" crc="e25380e6" map="0100"/>
            <part name="ikari-880a_t52.a2" crc="87607772" map="1000"/>
        </interleave>
        <interleave output="32">
            <part name="ik_12.d1" crc="4ebdba89" map="0001"/>
            <part name="ik_11.c1" crc="c33971c2" map="0010"/>
            <part name="ik_10.b1" crc="ba106245" map="0100"/>
            <part name="ik_9.a1" crc="711715ae" map="1000"/>
        </interleave>
        <!-- plds - starts at 0x380000 -->
        <part name="a_pal20l10a.ic1" crc="1cadf26d"/>
        <part name="b_pal20l10a.ic3" crc="c3d9e729"/>
        <part name="c_pal16l8a.ic2" crc="e258b8d6"/>
        <!-- Total 0x38029C bytes - 3584 kBytes -->
    </rom>

    <!-- hiscore: address[4] length[2] start end, MAME 0.288 plugins/hiscore/hiscore.dat -->
    <rom index="3" md5="none">
        <part>
            00 04 00 7E 00 58 00 1D
        </part>
    </rom>
    <nvram index="4" size="88"/>
</misterromdescription>
