    <switches default="DF,15" base="0">
        <dip name="Coin A"        bits="0,2"   ids="1C/5C,1C/6C,1C/3C,2C/1C,2C/3C,3C/1C,1C/2C,1C/1C"/>
        <dip name="Coin B"        bits="3,4"   ids="2C/3C,1C/2C,2C/1C,1C/1C"/>
        <dip name="Speed Unit"    bits="5,5"   ids="km/h,mph"/>
        <dip name="Demo Sounds"   bits="6,6"   ids="Off,On"/>
        <dip name="Speed"         bits="7,7"   ids="High,Average"/>
        <dip name="Extended Rank" bits="8,9"   ids="A,B,C,D"/>
        <dip name="Practice Rank" bits="10,11" ids="A,B,C,D"/>
        <dip name="Goal"          bits="12,13" ids="3,4,5,6"/>
        <dip name="Game Time"     bits="14,14" ids="90 secs,120 secs"/>
        <dip name="Freeze"        bits="15,15" ids="Off,On"/>
    </switches>

    <remark>Gran Premio F1 (Italian bootleg of Pole Position II)</remark>
    <mratimestamp>20260921000000</mratimestamp>
