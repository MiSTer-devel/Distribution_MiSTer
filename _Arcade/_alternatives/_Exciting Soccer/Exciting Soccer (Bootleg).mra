<misterromdescription>
    <name>Exciting Soccer (Bootleg)</name>
    <region>World</region>
    <homebrew>no</homebrew>
    <bootleg>yes</bootleg>
    <version></version>
    <alternative></alternative>
    <platform></platform>
    <series>Exciting Soccer</series>
    <year>1983</year>
    <manufacturer>bootleg (Kazutomi)</manufacturer>
    <category>Sports</category>

    <setname>exctsccrb</setname>
    <parent>exctsccr</parent>
    <mameversion>0270</mameversion>
    <rbf>ChampionBaseball</rbf>
    <about></about>

    <resolution>15kHz</resolution>
    <rotation>vertical (ccw)</rotation>
    <flip>yes</flip>

    <players>2 (alternating)</players>
    <joystick>8-way</joystick>
    <special_controls></special_controls>
    <num_buttons>2</num_buttons>
    <buttons names="Kick,Chase,-,Coin,Start 1P,Start 2P,Pause" default="A,B,Select,Start,R,L"/>

    <switches default="13">
        <dip bits="0,1" name="Coinage" ids="A 1C/3C B 1C/6C,A 1C/2C B 1C/4C,2C/1C,A 1C/1C B 3C/1C"/>
        <dip bits="2"   name="Demo Sounds" ids="On,Off"/>
        <dip bits="3"   name="Cabinet" ids="Upright,Cocktail"/>
        <dip bits="4"   name="Difficulty" ids="Hard,Easy"/>
        <dip bits="5,6" name="Game Time" ids="2 Min.,1 Min.,4 Min.,3 Min."/>
    </switches>

    <!-- Kazutomi bootleg: a conversion running on a modified Champion Baseball board. The original 
         Exciting Soccer board's improved sound hardware is missing here, hence its own 
         maincpu/audiocpu ROMs distinct from exctsccr's. -->

    <!-- Index 0: Main CPU ROMs (0x6000) -->
    <rom index="0" md5="none" zip="exctsccr.zip">
        <part crc="997c6a82" name="es-1.e2"/>
        <part crc="5c66e792" name="es-2.g2"/>
        <part crc="e0d504c0" name="es-3.h2"/>
    </rom>

    <!-- Index 1: Sound CPU ROMs (0x6000) -->
    <rom index="1" md5="none" zip="exctsccr.zip">
        <part crc="99e87b78" name="es-a.k2"/>
        <part crc="8b3db794" name="es-b.l2"/>
        <part crc="7bed2f81" name="es-c.m2"/>
    </rom>

    <!-- Index 2: GFX planes 0/1 (0x4000) -->
    <rom index="2" md5="none" zip="exctsccr.zip">
        <part crc="c342229b" name="4_a5.bin" offset="0x0000" length="0x1000"/>
        <part crc="35f4f8c9" name="5_b5.bin" offset="0x0000" length="0x1000"/>
        <part crc="c342229b" name="4_a5.bin" offset="0x1000" length="0x1000"/>
        <part crc="35f4f8c9" name="5_b5.bin" offset="0x1000" length="0x1000"/>
    </rom>

    <!-- Index 6: ALPHA-8201 MCU ROM (0x2000). -->
    <rom index="6" md5="none" zip="exctsccr.zip">
        <part crc="b77931ac" name="alpha-8201_44801a75_2f25.bin"/>
    </rom>

    <!-- Index 7: PROMs (0x220) -->
    <rom index="7" md5="none" zip="exctsccr.zip">
        <part crc="d9b10bf0" name="prom1.e1"/>
        <part crc="b5db1c2c" name="prom3.k5"/>
        <part crc="8a9c0edf" name="prom2.8r"/>
    </rom>

    <!-- Index 8: gfx1's plane-3 -->
    <rom index="8" md5="none" zip="exctsccr.zip">
        <part crc="eda40e32" name="6_c5.bin"/>
    </rom>

    <!-- Index 9: gfx3, 4bpp sprites (0x2000) -->
    <rom index="9" md5="none" zip="exctsccr.zip">
        <part crc="7f9cace2" name="2_k5.bin"/>
        <part crc="db2d9e0d" name="3_l5.bin"/>
    </rom>

    <!-- Index 5: game-select byte: 
           0x00 champbas    0x01 champbasj   0x02 champbasja  0x03 champbasjb
           0x04 champbb2    0x05 champbb2j   0x06 tbasebal    0x07 talbot
           0x08 exctsccr    0x09 exctscc2    0x0A exctsccrb                   -->
    <rom index="5"><part>0A</part></rom>

    <!-- Index 3: HiScore data - not working
    <rom index="3" md5="none">
        <part>
        00 00 FF FF 00 FF 00 10 00 10 00 08 FF FF 00 00
        00 00 8C 90 00 30 4D 00
        00 00 8C 60 00 03 02 00
        </part>
    </rom>
    -->

    <!-- Index 4: hiscore data. 0x30 + 0x03 = 51 bytes -->
    <rom index="4"></rom>
    <nvram index="4" size="51"></nvram>

    <remark>Exciting Soccer (bootleg, Kazutomi)</remark>
    <mratimestamp>20260824000000</mratimestamp>
</misterromdescription>
