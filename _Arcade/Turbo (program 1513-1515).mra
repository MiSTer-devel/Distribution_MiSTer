	<version>Program 1513-1515</version>
	<alternative></alternative>
	<platform></platform>
	<series>Turbo</series>
	<year>1981</year>
	<manufacturer>Sega</manufacturer>
	<category>Driving - Race</category>

	<setname>turbo</setname>
