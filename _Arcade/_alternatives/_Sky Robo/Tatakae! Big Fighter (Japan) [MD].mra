<misterromdescription>
  <name>Tatakae! Big Fighter (Japan)</name>
  <mameversion>0288</mameversion>
  <setname>bigfghtr</setname>
  <year>1989</year>
  <manufacturer>Nichibutsu</manufacturer>
  <category>Shoot 'em up</category>
  <rotation>horizontal</rotation>
  <parent>skyrobo</parent>
  <rbf>ArmedFMD</rbf>

  <switches default="df,ff">
    <!-- DSW0 -->
    <dip name="Lives" bits="0,1" ids="3,4,5,6" values="3,2,1,0"/>
    <dip name="Bonus Life" bits="2,3" ids="80k/every 80k,80k/every 100k,100k/every 80k,100k/every 100k" values="3,1,2,0"/>
    <dip name="Demo Sounds" bits="4" ids="On,Off" values="1,0"/>
    <dip name="Cabinet" bits="5" ids="Upright,Cocktail" values="0,1"/>
    <dip name="Difficulty" bits="6,7" ids="Easy,Normal,Hard,Hardest" values="3,2,1,0"/>
    <!-- DSW1 -->
    <dip name="Coin A" bits="8,9" ids="2 Coins/1 Credit,1 Coin/1 Credit,1 Coin/2 Credits,Free Play" values="1,3,2,0"/>
    <dip name="Coin B" bits="10,11" ids="2 Coins/1 Credit,1 Coin/1 Credit,2 Coins/3 Credits,1 Coin/2 Credits" values="1,3,0,2"/>
    <dip name="Unknown" bits="12" ids="Off,On" values="1,0"/>
    <dip name="Debug 2 (Skip/Invuln.)" bits="13" ids="Off,On" values="1,0"/>
    <dip name="Flip Screen" bits="14" ids="Off,On" values="1,0"/>
    <dip name="Debug (P1 Start Pause)" bits="15" ids="Off,On" values="1,0"/>
  </switches>

  <buttons names="Beam,Transform,-,-,Start,Coin,Pause,-,-,Save/Load" default="A,B,Start,Select,R,L"/>

  <rom index="0" zip="bigfghtr.zip|skyrobo.zip" md5="b00d7a38a842d2c415716381b04c1278">
    <!-- maincpu - starts at 0x0 -->
    <interleave output="16">
      <part name="3.ic3" crc="e1e1f291" map="01"/>
      <part name="1.ic2" crc="1100d991" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="4.ic5" crc="2464a83b" map="01"/>
      <part name="2.ic4" crc="b47bbcd5" map="10"/>
    </interleave>

    <!-- foreground - starts at 0x80000 -->
    <part name="5.13f" crc="d440a29f"/>
    <part name="6.15f" crc="27469a76"/>
    <part repeat="0x10000">FF</part>

    <!-- background - starts at 0xc0000 -->
    <part name="12.8a" crc="a5694ea9"/>
    <part name="11.6a" crc="10b74e2c"/>
    <part repeat="0x20000">FF</part>

    <!-- sprite - starts at 0x100000 -->
    <interleave output="16">
      <part name="9.8d" crc="fe67800e" map="01"/>
      <part name="10.9d" crc="dcb828c4" map="10"/>
    </interleave>

    <!-- text - starts at 0x140000 -->
    <part name="7.11c" crc="1809e79f"/>
    <part repeat="0x8000">FF</part>

    <!-- audiocpu - starts at 0x150000 -->
    <part name="8.17k" crc="0aeab61e"/>

    <!-- extra - starts at 0x160000 -->
    <part repeat="0x10000">FF</part>

    <!-- mcu - starts at 0x170000 -->
    <part name="i8751.bin" crc="64a0d225"/>
    <part repeat="0xf000">FF</part>

    <!-- nb1414m4 - starts at 0x180000 -->
    <part repeat="0x10000">FF</part>

    <!-- proms - starts at 0x190000 -->
    <part name="tf.13h" crc="81244757"/>
    <part repeat="0x3f00">FF</part>

    <!-- Total 0x194000 bytes -->
  </rom>

  <!-- game select (pcb) -->
  <rom index="1">
    <part>03</part>
  </rom>

  <!-- hiscore table: address[4], length[2], start byte, end byte - verified with MAME 0.288 RAM probe (not in hiscore.dat) -->
  <rom index="3" md5="none">
    <part>
      00 08 07 EA 00 50 00 FF
    </part>
  </rom>
  <nvram index="4" size="80"/>
</misterromdescription>
