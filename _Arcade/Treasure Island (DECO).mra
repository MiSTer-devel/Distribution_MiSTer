<?xml version="1.0" encoding="UTF-8"?>
<!--
  Treasure Island (US) (set 1) (ctisland) — Type 1 Dongle, decocrom overlay-PCB ROM

  Per MAME decocass.cpp:
  - GAME(1981, ctisland, decocass, ctisland, ctisland, decocass_type1_state, init_decocrom, ROT270,
    "Data East Corporation", "Treasure Island (DECO Cassette) (US) (set 1)", 0)   (line 2151)
  - init_decocrom (decocass.cpp:2095-2105): banks the "user3" overlay-PCB ROM region over charram
    ($6000-$AFFF) via a rombank; bank 0 = normal charram (RAM), bank 1 = user3+$0000, bank 2 =
    user3+$5000. Selected by writes to $E900 (decocass_e900_w, decocass_m.cpp:1271-1279). NOT a
    dongle mechanism — a separate address-decode feature (rtl/decocass.v de0091_bank).
  - Dongle: Type 1 (DE-0061), game_id=16 (DECO release 16), config already in dongle_type1.v
    (decocass_m.cpp:1554-1561, m_type1_map=type1_latch_26_pass_3_inv_2_table, inmap/outmap=
    MAKE_MAP(2,1,0,3,4,5,6,7)).
  - user3 ROM (deco-ti.x1-x4, 4x4 KB = 16 KB) loaded on its OWN ioctl index = 2 -> a dedicated
    on-chip BRAM (rtl decocass.v user3_addr_w / Arcade-DECOCassette.sv user3_rom) — small enough
    that no SDRAM is needed (unlike the 1 MB Darksoft/Widel multigame dongle ROMs on index 1).

  Region map (index 0) matches rtl/rom/rom_loader.v:
    $00000-$00FFF  Main 6502 BIOS  = v0b-.7e  (BIOS B / USA, 4 KB)
    $01000-$017FF  Audio 6502 BIOS = v1-.5a   (2 KB)
    $01800-$01BFF  MCU ROM         = cassmcu.1c (1 KB)
    $01C00-$01CFF  BIOS PROMs      (3 x 32 B + 160 B pad)
    $01D00-$02CFF  legacy 4 KB dongle PROM region (UNUSED; dongle loads via ioctl index 1; zeros)
    $02D00-$02DFF  Spare
    $02E00-$02EFF  Metadata: dongle_type=01 (Type 1), game_id=10 (=16 dec), swap_mode=00 (unused, type1 has no swap input)
    $02F00-$02FFF  Reserved
    $03000-       Cassette image (ctisland.cas, 32 KB)
  index 1: Type-1 dongle PROM (de-0061.pro, 32 B).
  index 2: decocrom overlay-PCB ROM (deco-ti.x1..x4, 16 KB total — fills only bank 1; bank 2 unused
           by this game but still addressable, reading zero/undefined BRAM if ever selected).
-->
<misterromdescription>
    <name>Treasure Island (US) (set 1)</name>
    <setname>ctisland</setname>
    <rbf>DECOCassette</rbf>
    <mameversion>0268</mameversion>
    <year>1981</year>
    <manufacturer>Data East Corporation</manufacturer>
    <category>Action</category>

  	<rotation>vertical (ccw)</rotation>

    <rom index="0" zip="decocass.zip|ctisland.zip" md5="none">
        <!-- $00000-$00FFF: Main 6502 BIOS (BIOS B / USA) -->
        <part name="v0b-.7e" crc="23d929b7"/>

        <!-- $01000-$017FF: Audio 6502 BIOS -->
        <part name="v1-.5a" crc="b66b2c2a"/>

        <!-- $01800-$01BFF: MCU ROM -->
        <part name="cassmcu.1c" crc="a6df18fd"/>

        <!-- $01C00-$01CFF: BIOS PROMs (96 B + 160 B pad) -->
        <part name="v2.3m"  crc="238fdb40"/>
        <part name="v4.10d" crc="3b5836b4"/>
        <part name="v3.3j"  crc="51eef657"/>
        <part repeat="0xA0">00</part>

        <!-- $01D00-$02CFF: legacy 4 KB dongle PROM region (unused; dongle moved to ioctl index 1; zeros) -->
        <part repeat="0x1000">00</part>

        <!-- $02D00-$02DFF: Spare -->
        <part repeat="0x100">00</part>

        <!-- $02E00-$02EFF: Metadata (Type 1, game_id=10 hex = DECO release 16, swap_mode unused) -->
        <part>01 10 00</part>
        <part repeat="0xFD">00</part>

        <!-- $02F00-$02FFF: Reserved -->
        <part repeat="0x100">00</part>

        <!-- $03000-: Cassette image -->
        <part name="ctisland.cas" crc="3f63b8f8"/>
    </rom>

    <rom index="1" zip="decocass.zip|ctisland.zip" md5="none">
        <part name="de-0061.pro" crc="e09ae5de"/>
    </rom>

    <!-- decocrom overlay-PCB ROM (MAME "user3") — bank-switched over charram $6000-$AFFF via $E900.
         Loaded sequentially = matches MAME's ROM_LOAD offsets 0x0000/0x1000/0x2000/0x3000 exactly. -->
    <rom index="2" zip="decocass.zip|ctisland.zip" md5="none">
        <part name="deco-ti.x1" crc="a7f8aeba"/>
        <part name="deco-ti.x2" crc="2a0d3c91"/>
        <part name="deco-ti.x3" crc="3a26b97c"/>
        <part name="deco-ti.x4" crc="1cbe43de"/>
    </rom>

    <!-- DSW2 bits 16 (Lives) / 17-18 (Bonus Life) are ctisland-specific overrides (decocass.cpp:735-747,
         PORT_MODIFY over the base "decocass" port); MAME comment: "other dips not verified", so DSW2
         bits 19-20 and all of DSW1 are left at the standard decocass base block. -->
    <switches default="00,00,FF,3F">
        <dip bits="16"    name="Lives"      ids="5,3"/>
        <dip bits="17,18" name="Bonus Life" ids="15000,20000,25000,30000"/>
        <dip bits="21,23" name="Country Code" ids="inv,inv,F,E,D,C,B,A"/>
        <dip bits="24,25" name="Coin A" ids="2C/1C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="26,27" name="Coin B" ids="2C/1C,1C/3C,1C/2C,1C/1C"/>
        <dip bits="28,29" name="Type of Tape" ids="MT Big,inv,inv,MD Small"/>
        <dip bits="30" name="Cabinet" ids="Upright,Cocktail"/>
    </switches>

    <buttons names="Button1,Button2,Coin,Start 1P,Start 2P,Pause" default="A,B,Select,Start,R,L"/>
</misterromdescription>
