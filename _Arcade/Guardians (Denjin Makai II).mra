    <dip bits="12,13,14,15" name="Coin B" ids="Free Play,4C/3C,4C/1C,3C/4C,3C/2C,3C/1C,2C/5C,2C/3C,2C/1C,1C/7C,1C/6C,1C/5C,1C/4C,1C/3C,1C/2C,1C/1C" />
  </switches>
  <!--
    Standard MiSTer 16-byte cheat codes: flags, address, compare, replacement.
    Addresses and values come from Pugsy's Guardians entry by pasky13.
  -->
  <cheats>
    <cheat name="Infinite Credits">000000 10 002014F1 00000000 00000009</cheat>
    <cheat name="Infinite Time">000000 10 00201312 00000000 0000009A</cheat>
    <cheat name="P1 Infinite Lives">000000 10 00201629 00000000 0000000A</cheat>
    <cheat name="P1 Infinite Energy">
      000000 20 00203142 00000000 000002C0
      000000 20 00203144 00000000 000002C0
