<misterromdescription>
    <name>Gang Wars (bootleg)</name>
    <setname>gangwarsb</setname>
    <parent>gangwars</parent>
    <rbf>Alpha68kMD</rbf>
    <mameversion>0288</mameversion>
    <year>1989</year>
    <manufacturer>bootleg</manufacturer>
    <region>World</region>
    <joystick>8-Way</joystick>
    <rotation>horizontal</rotation>

    <switches default="fe,ff">
        <!-- IN3 -->
        <dip name="Unused" bits="10" ids="Off,On" values="1,0"/>
        <dip name="Lives" bits="11" ids="3,4" values="1,0"/>
        <dip name="Timer Speed" bits="12" ids="Slow,Normal" values="0,1"/>
        <dip name="Difficulty" bits="13,14" ids="Easy,Normal,Hard,Hardest" values="2,3,1,0"/>
        <dip name="Demo Sounds" bits="15" ids="Off,On" values="0,1"/>
        <!-- IN4 -->
        <dip name="Coin Slots" bits="0" ids="1,2" values="0,1"/>
        <dip name="Coinage" bits="1,3" ids="5 Coins/1 Credit,3 Coins/1 Credit,2 Coins/1 Credit,1 Coin/1 Credit,1 Coin/2 Credits,1 Coin/3 Credits,1 Coin/4 Credits,1 Coin/5 Credits" values="0,1,2,7,6,5,4,3"/>
        <dip name="Flip Screen" bits="4" ids="Off,On" values="1,0"/>
        <dip name="Freeze" bits="5" ids="Off,On" values="1,0"/>
    </switches>

    <buttons names="Kick,Punch,Jump,-,-,Start,Coin,Pause,Save States" default="A,B,X,Start,Select,R,L"/>

    <rom index="1">
        <part>01 3A</part>
    </rom>

    <rom index="0" zip="gangwarsb.zip|gangwars.zip" md5="None">

        <!-- maincpu - starts at 0x0 -->
        <interleave output="16">
            <part name="gwb_ic.m15" crc="7752478e" map="01"/>
            <part name="gwb_ic.m16" crc="c2f3b85e" map="10"/>
