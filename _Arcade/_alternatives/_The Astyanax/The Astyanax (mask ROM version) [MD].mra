<misterromdescription>
    <name>The Astyanax (mask ROM version)</name>
    <setname>astyanaxa</setname>
    <rbf>MegaSys1_AMD</rbf>
    <mameversion>0288</mameversion>
    <year>1989</year>
    <manufacturer>Jaleco</manufacturer>
    <players>2</players>
    <joystick>8-way</joystick>
    <rotation>Horizontal</rotation>

    <!-- DIP switches: MAME 0.288 -listxml -->
    <switches default="BF,FF">
        <dip name="Coin A" bits="0,2" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/1Cr" values="0,4,2,7"/>
        <dip name="Coin B" bits="3,5" ids="4C/1Cr,3C/1Cr,2C/1Cr,1C/1Cr" values="0,4,2,7"/>
        <dip name="Demo Sounds" bits="6" ids="Off,On" values="1,0"/>
        <dip name="Test Mode" bits="7" ids="Off,On" values="1,0"/>
        <dip name="Unused" bits="8" ids="Off,On" values="1,0"/>
        <dip name="Unused" bits="9" ids="Off,On" values="1,0"/>
        <dip name="Bonus Life" bits="10" ids="30k/70k/110k+30k,50k/100k/+40k" values="1,0"/>
        <dip name="Lives" bits="11,12" ids="2,3,4,5" values="1,3,2,0"/>
        <dip name="Difficulty" bits="13" ids="Normal,Hard" values="1,0"/>
        <dip name="Swap 1P/2P Controls" bits="14" ids="Off,On" values="1,0"/>
        <dip name="Flip Screen" bits="15" ids="Off,On" values="1,0"/>
    </switches>

    <!-- button names: va7deo MRAs -->
    <buttons names="Attack,Jump,Thunder Attack,Start,Coin,Pause,Save/Load" default="A,B,X,Start,Select,R,L"/>

    <rom index="1">
        <part>06</part>
    </rom>

    <rom index="2">
        <part>
            00 00 14 32   00 00 43 12   00 04 30 12   00 00 12 43
            00 01 04 32   00 01 43 02   00 04 31 02   00 01 02 43
            00 00 24 31   00 00 24 31   00 04 30 21   00 00 24 43
            00 01 24 30   00 01 43 20   00 04 31 20   00 01 20 43
        </part>
    </rom>

    <rom index="3">
        <part>10</part>
    </rom>

    <rom index="0" zip="astyanaxa.zip|astyanax.zip" md5="none">
        <!-- maincpu - starts at 0x0 -->
        <interleave output="16">
            <part name="astyan2.bin" crc="1b598dcc" map="01"/>
            <part name="astyan1.bin" crc="1a1ad3cf" map="10"/>
        </interleave>
        <interleave output="16">
            <part name="astyan3.bin" crc="097b53a6" map="01"/>
            <part name="astyan4.bin" crc="1e1cbdb2" map="10"/>
        </interleave>
        <part repeat="0x20000">FF</part>

        <!-- audiocpu - starts at 0x80000 -->
        <interleave output="16">
            <part name="astyan5.bin" crc="11c74045" map="01"/>
            <part name="astyan6.bin" crc="eecd4b16" map="10"/>
        </interleave>
        <part repeat="0x60000">FF</part>

        <!-- oki1 - starts at 0x100000 -->
        <part name="10.bin" crc="d888ab84"/>
        <part repeat="0x80000">FF</part>

        <!-- oki2 - starts at 0x200000 -->
        <part name="8.bin" crc="8d060fe9"/>

        <!-- scroll1 - starts at 0x280000 -->
        <part name="14.bin" crc="37388363"/>

        <!-- scroll2 - starts at 0x300000 -->
        <part name="18.bin" crc="76932191"/>

        <!-- scroll3 - starts at 0x380000 -->
        <part name="astyan19.bin" crc="98158623"/>
        <part repeat="0x60000">FF</part>

        <!-- sprites - starts at 0x400000 -->
        <part name="23.bin" crc="9bd34a6b"/>
        <part repeat="0x80000">FF</part>

        <!-- proms - starts at 0x500000 -->
        <part name="rd.14m" crc="85b30ac4"/>

    </rom>

    <!-- hiscore table: address[4], length[2], start byte, end byte - MAME 0.288 plugins/hiscore/hiscore.dat -->
    <rom index="4" md5="none">
        <part>
            00 0F 89 09 00 97 00 4E
            00 0F 88 5D 00 0F 00 00
            00 0F 88 63 00 01 02 02
            00 09 83 47 00 01 00 00
            00 09 83 87 00 01 31 31
            00 09 83 C7 00 01 32 32
            00 09 84 07 00 01 30 30
            00 09 84 47 00 01 30 30
            00 09 84 87 00 01 30 30
            00 09 84 C7 00 01 30 30
        </part>
    </rom>
    <nvram index="5" size="174"/>
</misterromdescription>
