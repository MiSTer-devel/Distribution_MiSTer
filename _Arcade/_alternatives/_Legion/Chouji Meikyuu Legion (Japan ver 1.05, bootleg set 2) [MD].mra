<misterromdescription>
  <name>Chouji Meikyuu Legion (Japan ver 1.05, bootleg set 2)</name>
  <mameversion>0288</mameversion>
  <setname>legionjb2</setname>
  <year>1987</year>
  <manufacturer>bootleg</manufacturer>
  <category>Shoot 'em up</category>
  <rotation>vertical (ccw)</rotation>
  <parent>legion</parent>
  <rbf>ArmedFMD</rbf>

  <switches default="f7,ff">
    <!-- DSW1 -->
    <dip name="Lives" bits="0,1" ids="3,4,5,6" values="3,2,1,0"/>
    <dip name="Bonus Life" bits="2" ids="30k/every 100k,50k Only" values="1,0"/>
    <dip name="Demo Sounds" bits="3" ids="Off,On" values="1,0"/>
    <dip name="Flip Screen" bits="4" ids="Off,On" values="1,0"/>
    <dip name="Unused" bits="5" ids="Off,On" values="1,0"/>
    <dip name="Unused" bits="6" ids="Off,On" values="1,0"/>
    <dip name="Unused" bits="7" ids="Off,On" values="1,0"/>
    <!-- DSW2 -->
    <dip name="Coin A" bits="8,9" ids="2 Coins/1 Credit,1 Coin/1 Credit,1 Coin/2 Credits,Free Play" values="1,3,2,0"/>
    <dip name="Coin B" bits="10,11" ids="2 Coins/1 Credit,1 Coin/1 Credit,2 Coins/3 Credits,1 Coin/2 Credits" values="1,3,0,2"/>
    <dip name="Coin Slots" bits="12" ids="Common,Individual" values="1,0"/>
    <dip name="Difficulty" bits="13" ids="Easy,Hard" values="1,0"/>
    <dip name="Unused" bits="14" ids="Off,On" values="1,0"/>
    <dip name="Unused" bits="15" ids="Off,On" values="1,0"/>
  </switches>

  <buttons names="Beam,Time Bomb,-,-,Start,Coin,Pause,-,-,Save/Load" default="A,B,Start,Select,R,L"/>

  <rom index="0" zip="legionjb2.zip|legion.zip" md5="59da2c3d374f24f73951019ed0ff9047">
    <!-- maincpu - starts at 0x0 -->
    <interleave output="16">
      <part name="4-legion-27512.e5" crc="73a68507" map="01"/>
      <part name="6-legion-27512.e1" crc="fb3d944f" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="3-legion-27512.e7" crc="c2e45e1e" map="01"/>
      <part name="5-legion-27512.e3" crc="c306660a" map="10"/>
    </interleave>
    <part repeat="0x40000">FF</part>

    <!-- foreground - starts at 0x80000 -->
    <part name="2-legion-27512.e12" crc="a9d70faf"/>
    <part repeat="0x8000">FF</part>
    <part name="1-legion-24256.e14" crc="f018313b"/>
    <part repeat="0x20000">FF</part>

    <!-- background - starts at 0xc0000 -->
    <part name="10-legion-27512.e15" crc="29b8adaa"/>
    <part repeat="0x30000">FF</part>

    <!-- sprite - starts at 0x100000 -->
    <interleave output="16">
      <part name="11-legion-27512.e10" crc="ff5a0db9" map="01"/>
      <part name="12-legion-27512.e7" crc="bae220c8" map="10"/>
    </interleave>
    <part repeat="0x20000">FF</part>

    <!-- text - starts at 0x140000 -->
    <part name="7-legion-24256.c9" crc="c50b0125"/>
    <part repeat="0x8000">FF</part>

    <!-- audiocpu - starts at 0x150000 -->
    <part name="9-legion-24128.h15" crc="2ca4f7f0"/>
    <part name="8-legion-24256.h17" crc="79f4a827"/>
    <part repeat="0x4000">FF</part>

    <!-- extra - starts at 0x160000 -->
    <part repeat="0x10000">FF</part>

    <!-- mcu - starts at 0x170000 -->
    <part repeat="0x10000">FF</part>

    <!-- nb1414m4 - starts at 0x180000 -->
    <part repeat="0x10000">FF</part>

    <!-- proms - starts at 0x190000 -->
    <part repeat="0x4000">FF</part>

    <!-- Total 0x194000 bytes -->
  </rom>

  <!-- game select (pcb) -->
  <rom index="1">
    <part>07</part>
  </rom>

  <!-- hiscore table: address[4], length[2], start byte, end byte - verified with MAME 0.288 RAM probe (not in hiscore.dat) -->
  <rom index="3" md5="none">
    <part>
      00 06 2E 8C 00 27 00 29
      00 06 2F DC 00 04 00 00
    </part>
  </rom>
  <nvram index="4" size="43"/>
</misterromdescription>
