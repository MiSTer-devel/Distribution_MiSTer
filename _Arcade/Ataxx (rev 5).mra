	<!--
	  Buttons are ordered player controls, then coin, then start: Place, Coin, Start. The two
	  trackballs are driven by a mouse (player 1), the analog stick, the D-pad or a spinner;
	  the operator menu is opened from the OSD "Service Menu". Re-run "Define joystick
	  buttons" in the OSD after updating, since the order changed.
	-->
	<buttons names="Place,Coin,Start"></buttons>

