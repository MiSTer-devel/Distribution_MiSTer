<misterromdescription>
  <name>Terra Cresta (YM3526 set 3)</name>
  <mameversion>0288</mameversion>
  <setname>terracrea</setname>
  <year>1985</year>
  <manufacturer>Nichibutsu</manufacturer>
  <category>Shoot 'em up</category>
  <rotation>vertical (ccw)</rotation>
  <parent>terracre</parent>
  <rbf>TerraCrestaMD</rbf>

  <switches default="df,ff,ff,ff">
    <!-- DSW -->
    <dip name="Lives" bits="0,1" ids="3,4,5,6" values="3,2,1,0"/>
    <dip name="Bonus Life" bits="2,3" ids="20k/every 60k,30k/every 70k,40k/every 80k,50k/every 90k" values="3,2,1,0"/>
    <dip name="Demo Sounds" bits="4" ids="Off,On" values="0,1"/>
    <dip name="Cabinet" bits="5" ids="Upright,Cocktail" values="0,1"/>
    <dip name="Unused" bits="6" ids="Off,On" values="1,0"/>
    <dip name="Unused" bits="7" ids="Off,On" values="1,0"/>
    <dip name="Coin A" bits="8,9" ids="2 Coins/1 Credit,1 Coin/1 Credit,1 Coin/2 Credits,Free Play" values="1,3,2,0"/>
    <dip name="Coin B" bits="10,11" ids="3 Coins/1 Credit,2 Coins/3 Credits,1 Coin/3 Credits,1 Coin/6 Credits" values="0,1,3,2"/>
    <dip name="Difficulty" bits="12" ids="Easy,Hard" values="1,0"/>
    <dip name="Flip Screen" bits="13" ids="Off,On" values="1,0"/>
    <dip name="Complete Invuln. Cheat" bits="14" ids="Off,On" values="1,0"/>
    <dip name="Base Ship Invuln. Cheat" bits="15" ids="Off,On" values="1,0"/>
    <!-- SYSTEM -->
    <dip name="Service Mode" bits="29" ids="Off,On" values="1,0"/>
  </switches>

  <buttons names="Cannon Beam,Formation,Start,Coin,Pause,Save/Load" default="A,B,Start,Select,R,L"/>

  <rom index="0" zip="terracrea.zip|terracre.zip" md5="8c6a6cbaee6ac7e16c0d39c5cc3ef929">
    <!-- maincpu - starts at 0x0 -->
    <interleave output="16">
      <part name="1.4b" crc="76f17479" map="01"/>
      <part name="5.4d" crc="8119f06e" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="2.6b" crc="ba4b5822" map="01"/>
      <part name="6.6d" crc="ca4852f6" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="3.7b" crc="d0771bba" map="01"/>
      <part name="7.7d" crc="029d59d9" map="10"/>
    </interleave>
    <interleave output="16">
      <part name="4.9b" crc="69227b56" map="01"/>
      <part name="8.9d" crc="5a672942" map="10"/>
    </interleave>

    <!-- bgtiles - starts at 0x20000 -->
    <part name="9.15f" crc="984a597f"/>
    <part name="10.17f" crc="30e297ff"/>
    <part repeat="0x10000">FF</part>

    <!-- sprites - starts at 0x40000 -->
    <part name="14.6e" crc="bcf7740b"/>
    <part name="15.7e" crc="a70b565c"/>
    <part name="16.6g" crc="4a9ec3e6"/>
    <part name="17.7g" crc="450749fc"/>
    <part repeat="0x10000">FF</part>

    <!-- fgtiles - starts at 0x60000 -->
    <part name="18.16g" crc="591a3804"/>
    <part repeat="0xe000">FF</part>

    <!-- audiocpu - starts at 0x70000 -->
    <part name="11.15b" crc="604c3b11"/>
    <part name="12.17b" crc="9e9b3808"/>
    <part name="13.18b" crc="302dc0ab"/>

    <!-- prot_chip - starts at 0x7c000 -->
    <part repeat="0x2000">FF</part>

    <!-- proms - starts at 0x7e000 -->
    <part name="3.10f" crc="ce07c544"/>
    <part name="2.11f" crc="566d323a"/>
    <part name="1.12f" crc="7ea63946"/>
    <part name="4.2g" crc="08609bad"/>

    <!-- palbank_prom - starts at 0x7e400 -->
    <part name="5.4e" crc="2c43991f"/>

    <!-- Total 0x7e500 bytes -->
  </rom>

  <!-- game select (pcb) -->
  <rom index="1">
    <part>00</part>
  </rom>

  <!-- hiscore table: address[4], length[2], start byte, end byte - MAME 0.288 plugins/hiscore/hiscore.dat -->
  <rom index="3" md5="none">
    <part>
      00 02 02 46 00 46 00 00
      00 02 02 8C 00 04 00 00
      00 02 02 48 00 01 50 50
    </part>
  </rom>
  <nvram index="4" size="75"/>
</misterromdescription>
